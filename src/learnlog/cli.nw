def test_play_refuses_a_log_with_nothing_to_show(workdir):
    """A log whose every record is hidden is refused, not crashed."""
    from learnlog.cli import app
    from learnlog.commits import get_commits
    from typer.testing import CliRunner
    repo = LearnlogRepo(workdir)
    initial = get_commits(repo)[0]["hash"]
    repo.begin_run(
        "learnlog", ["list"], datetime.datetime(2026, 1, 1, 10, 0),
    )
    branch = repo.recording_branch()
    kept = repo.git("rev-list", "--reverse", branch).stdout.split()
    rest = [h for h in kept if h != initial]
    tree = repo.git("rev-parse", f"{rest[0]}^{{tree}}").stdout.strip()
    message = repo.git("log", "-1", "--format=%B", rest[0]).stdout
    root = repo.git(
        "commit-tree", tree, input=message,
    ).stdout.strip()
    repo.git("update-ref", branch, root)
    runner = CliRunner()
    result = runner.invoke(app, ["play", "-b", "--from", str(workdir)])
    assert result.exit_code == 1
    assert "Nothing to play" in result.output
    assert "--all" in result.output
    result = runner.invoke(
        app, ["play", "-b", "--all", "--from", str(workdir)],
    )
    assert result.exit_code == 0
