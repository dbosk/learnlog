def test_pull_no_remote_fails(workdir, monkeypatch):
    """Pull fails when no remote is configured."""
    from learnlog.cli import app
    from typer.testing import CliRunner
    repo = LearnlogRepo(workdir)
    monkeypatch.chdir(workdir)
    runner = CliRunner()
    result = runner.invoke(app, ["pull"])
    assert result.exit_code != 0
@

The tests that follow all need the same two-machine situation---one
log, pushed to a remote, cloned back into a second directory---so we
build it once.
The clone's work tree starts empty, which is what [[clone]] leaves
behind (\cref{sec:clone}); the student's files in it are the ones the
test writes.
A cloned repository has never been through [[init_repo]], so it lacks
the settings that make committing work regardless of the developer's
global Git configuration; the tests below record runs in the clone, so
the helper applies the one that matters.

<<test functions>>=
def _two_machine_log(workdir, runner, monkeypatch):
    """Push a log to a bare remote and clone it back.

    Returns the clone's directory.
    """
    from learnlog.cli import app
    bare = workdir / "remote.git"
    subprocess.run(
        ["git", "init", "--bare", str(bare)],
        capture_output=True, check=True,
    )
    monkeypatch.chdir(workdir)
    runner.invoke(app, ["set-remote", str(bare)])
    runner.invoke(app, ["push"])
    target = workdir / "clone-target"
    target.mkdir()
    monkeypatch.chdir(target)
    runner.invoke(app, ["clone", str(bare)])
    LearnlogRepo(target).git(
        "config", "commit.gpgsign", "false",
    )
    return target
@

The first thing to check is the one the old implementation got wrong
every time: a student with an uncommitted edit pulls, and the edit
survives byte for byte even though the incoming commit changes that
very file.
Listing the clone directory afterwards is the sharper half of the
test---a merge into the live work tree would have checked out
everything the other machine had, so finding nothing but the student's
own file says the merge went somewhere else entirely:

<<test functions>>=
def test_pull_leaves_the_work_tree_alone(workdir, monkeypatch):
    """A fast-forward pull does not write the student's files."""
    from learnlog.cli import app
    from typer.testing import CliRunner
    repo = LearnlogRepo(workdir)
    runner = CliRunner()
    target = _two_machine_log(workdir, runner, monkeypatch)
    student = target / "hello.py"
    student.write_text('print("mine, uncommitted")\n')
    monkeypatch.chdir(workdir)
    (workdir / "hello.py").write_text('print("theirs")\n')
    repo.begin_run(
        "hello.py", [], datetime.datetime(2026, 1, 1, 11, 0),
    )
    runner.invoke(app, ["push"])

    monkeypatch.chdir(target)
    result = runner.invoke(app, ["pull"])

    assert result.exit_code == 0
    assert student.read_text() == 'print("mine, uncommitted")\n'
    cloned = LearnlogRepo(target)
    assert 'print("theirs")' in cloned.git(
        "show", "HEAD:hello.py",
    ).stdout
    assert sorted(entry.name for entry in target.iterdir()) == [
        ".learnlog", "hello.py",
    ]
    for artefact in ("MERGE_HEAD", "MERGE_MSG"):
        assert not (target / ".learnlog" / artefact).exists()
