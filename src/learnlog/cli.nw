The remaining property is the one a race would violate, and races are
not something a test can reliably provoke.
What we can check deterministically is the arrangement that prevents
it: we wrap [[commit_lock]] and [[git]] on the repository class,
record whether the lock was held at the moment [[update-ref]] ran, and
insist it was:

<<test functions>>=
def test_pull_advances_the_ref_under_the_lock(
    workdir, monkeypatch,
):
    """The branch update runs while the commit lock is held."""
    import contextlib
    from learnlog import gitrepo
    from learnlog.cli import app
    from typer.testing import CliRunner
    repo = LearnlogRepo(workdir)
    runner = CliRunner()
    target = _two_machine_log(workdir, runner, monkeypatch)
    monkeypatch.chdir(workdir)
    (workdir / "hello.py").write_text('print("v2")\n')
    repo.begin_run(
        "hello.py", [], datetime.datetime(2026, 1, 1, 11, 0),
    )
    runner.invoke(app, ["push"])

    held = []
    updates = []
    real_lock = gitrepo.LearnlogRepo.commit_lock
    real_git = gitrepo.LearnlogRepo.git

    @contextlib.contextmanager
    def watched_lock(self):
        held.append(self)
        try:
            with real_lock(self):
                yield
        finally:
            held.pop()

    def watched_git(self, *args, **kwargs):
        if args[:1] == ("update-ref",):
            updates.append(bool(held))
        return real_git(self, *args, **kwargs)

    monkeypatch.setattr(
        gitrepo.LearnlogRepo, "commit_lock", watched_lock,
    )
    monkeypatch.setattr(gitrepo.LearnlogRepo, "git", watched_git)
    monkeypatch.chdir(target)
    result = runner.invoke(app, ["pull"])

    assert result.exit_code == 0
    assert updates == [True]
@

Finally, the fallback for older Git needs its own run through the same
fast-forward-plus-divergence story, because on this machine the
version check would never choose it.
Forcing the choice is enough: everything after it is the code under
test.

