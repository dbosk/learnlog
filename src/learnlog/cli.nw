        lambda name: (
            "/usr/bin/python3"
            if name == "python3"
            else None
        ),
    )
    assert resolve_target_python() == pathlib.Path(
        "/usr/bin/python3"
    )

def test_resolve_target_python_errors_when_missing(monkeypatch):
    """SystemExit with a helpful message when nothing found."""
    from learnlog.cli import resolve_target_python
    monkeypatch.setattr("shutil.which", lambda name: None)
    with pytest.raises(SystemExit, match="Cannot find"):
        resolve_target_python()
