        ),
    ] = False,
    raw: Annotated[
        bool,
        typer.Option(
            "--raw", "-r",
            help=(
                "Show the recorded log format (git show "
                "output) instead of the reading view."
            ),
        ),
    ] = False,
    color: Annotated[
        bool | None,
        typer.Option(
            "--color/--no-color",
            help=(
                "Colour the output.  Default: only when "
                "writing to a terminal and NO_COLOR is "
                "unset."
            ),
        ),
    ] = None,
    resume: Annotated[
        bool,
        typer.Option(
            "--continue", "-c",
            help=(
                "Open on the record your previous learnlog "
                "play showed last."
            ),
        ),
    ] = False,
):
    """Interactively play back the development log."""
    import shutil

    if start and resume:
        raise SystemExit(START_OR_CONTINUE_NOTE)
    if resume:
        <<find the playback to continue>>
    repo, tmpdir = resolve_source(source)
    try:
        commits = get_commits(repo)
        if not commits:
            raise SystemExit("No commits found.")
        scan = scan_run_commits(repo)
        tag_map = get_tag_map(repo)
        records = visible_commits(
            commits, scan.messages, tag_map, show_all=show_all,
        )
        if not records:
            raise SystemExit(NOTHING_TO_PLAY_NOTE)

        start_index = None
        if start:
            <<find starting commit index>>
        elif resume:
            <<find the record last viewed>>

        <<choose playback mode>>
    finally:
        if tmpdir is not None:
            shutil.rmtree(tmpdir, ignore_errors=True)
