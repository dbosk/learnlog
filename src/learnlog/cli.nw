    from learnlog.cli import app
    from typer.testing import CliRunner
    repo = LearnlogRepo(workdir)
    bare = workdir / "remote.git"
    subprocess.run(
        ["git", "init", "--bare", str(bare)],
        capture_output=True, check=True,
    )
    runner = CliRunner()
    monkeypatch.chdir(workdir)
    runner.invoke(app, ["set-remote", str(bare)])
    runner.invoke(app, ["push"])
    target = workdir / "clone-target"
    target.mkdir()
    monkeypatch.chdir(target)
    runner.invoke(app, ["clone", str(bare)])
    # Add a new commit in the original and push.
    monkeypatch.chdir(workdir)
    (workdir / "hello.py").write_text(
        'print("v2")\n'
    )
    t = datetime.datetime(2026, 1, 1, 11, 0)
    repo.begin_run("hello.py", [], t)
    runner.invoke(app, ["push"])
    # Pull in the cloned directory.
    monkeypatch.chdir(target)
    result = runner.invoke(app, ["pull"])
    assert result.exit_code == 0
    cloned_repo = LearnlogRepo(target)
    log = cloned_repo.git(
        "log", "--oneline"
    )
    lines = log.stdout.strip().split("\n")
