[[--changes]] is checked against a log in which one run edits the
file, one runs without editing it, and a checkout restores it.
The checkout's restored file is in its trailer, so the checkout
matching shows that the join of \cref{sec:record-files} reaches the
listing.
Given both options, a run must match both:

<<test functions>>=
def test_list_changes_finds_edits_and_checkouts(workdir):
    from learnlog.cli import app
    from typer.testing import CliRunner
    repo = LearnlogRepo(workdir)
    t = datetime.datetime(2026, 1, 1, 10, 0)
    program = workdir / "lab1" / "main.py"
    program.parent.mkdir()
    program.write_text("print(1)\n")
    repo.begin_run("hello.py", ["first"], t)
    first = repo.run_commit
    repo.begin_run("hello.py", ["again"], t)
    program.write_text("print(2)\n")
    repo.begin_run("hello.py", ["edited"], t)
    repo.begin_run("learnlog", ["checkout", first[:7]], t)
    repo.restore_code_state(first)
    tree = repo.git("rev-parse", f"{first}^{{tree}}").stdout.strip()
    repo.finalize_run(
        io_log="", exception_info=None, end_time=t, exit_code=0,
        tree=tree,
    )
    runner = CliRunner()

    def listed(*args):
        result = runner.invoke(
            app, ["list", *args, "--from", str(workdir)],
        )
        assert result.exit_code == 0, result.output
        return result.output

    changed = listed("--changes", "lab1/main.py")
    assert "hello.py first" in changed
    assert "hello.py edited" in changed
    assert "learnlog checkout" in changed
    assert "hello.py again" not in changed
    both = listed("--runs", "hello.py", "--changes", "main.py")
    assert "hello.py first" in both
    assert "hello.py edited" in both
    assert "learnlog checkout" not in both
@

The message map exists so that listing does not fork Git once per
run, and only a test can keep it that way: the O(N) version was
functionally indistinguishable, just slow.
Rather than pinning the exact number of Git calls---which may
drift as the repository plumbing changes---we pin the property
that matters: listing a longer log costs exactly as many Git
calls as listing a shorter one, with the file filters and without.
The tag filter reads nothing the plain listing does not, so on the
same tagged log the two cost the same.

<<test functions>>=
def test_list_git_calls_constant_in_log_length(workdir, monkeypatch):
    """Listing costs the same Git calls however long the log."""
    from learnlog.cli import app
    from typer.testing import CliRunner

    repo = LearnlogRepo(workdir)

    def record_runs(minutes):
        for minute in minutes:
            (workdir / "work.py").write_text(
                f"print({minute})\n"
            )
            repo.begin_run(
                "work.py", [],
                datetime.datetime(2026, 1, 1, 10, minute),
            )
            repo.finalize_run(
                io_log="",
                exception_info=None,
                end_time=datetime.datetime(
                    2026, 1, 1, 10, minute, 30
                ),
                exit_code=0,
            )

    record_runs(range(5))
    counted = []
    original = LearnlogRepo.git

    def counting_git(self, *args, **kwargs):
        counted.append(args)
        return original(self, *args, **kwargs)

    monkeypatch.setattr(LearnlogRepo, "git", counting_git)
    runner = CliRunner()
    filters = ["--runs", "work.py", "--changes", "work.py"]

    def calls(expected, *args):
        counted.clear()
        result = runner.invoke(
            app, ["list", *args, "--from", str(workdir)],
        )
        assert result.exit_code == 0
        assert result.output.count("work.py") == expected
        return len(counted)

    short_log_calls = calls(5)
    short_filtered_calls = calls(5, *filters)

    record_runs(range(5, 10))
    assert calls(10) == short_log_calls
    assert calls(10, *filters) == short_filtered_calls

    repo.git("tag", "lab1")
    assert calls(1, "--tags") == calls(10)
@


\subsection{The [[export]] command}

The [[export]] command resolves the learnlog directory using
[[resolve_workdir]] and delegates to [[do_export]] or
[[do_export_progsnap2]] depending on the [[--progsnap2]] flag.
It uses [[-C]] / [[--dir]] rather than [[resolve_source]] because
export does not need bundle support---we are \emph{creating}
bundles, not reading them.

When [[--progsnap2]] is set, the default output changes from
[[learnlog.learnlog]] to [[learnlog.progsnap2]].
We detect this by checking whether the user explicitly passed
[[-o]]---if the output still equals the bundle default, we
substitute the ProgSnap2 default.

<<typer commands>>=
@app.command()
def export(
    output: Annotated[
        pathlib.Path,
        typer.Option(
            "--output", "-o",
            help="Output file path.",
        ),
    ] = pathlib.Path(DEFAULT_BUNDLE_NAME),
    directory: Annotated[
        pathlib.Path | None,
        typer.Option(
            "--dir", "-C",
            help="Directory containing .learnlog/.",
        ),
    ] = None,
    progsnap2: Annotated[
        bool,
        typer.Option(
            "--progsnap2",
            help=(
                "Export as ProgSnap2 zip instead of "
                "a Git bundle."
            ),
        ),
    ] = False,
):
    """Export the learnlog repository as a learnlog or ProgSnap2 bundle."""
    workdir = resolve_workdir(directory)
    repo = LearnlogRepo(workdir)

    if progsnap2 and output == pathlib.Path(
        DEFAULT_BUNDLE_NAME
    ):
        output = pathlib.Path(DEFAULT_PROGSNAP2_NAME)

    write_export_atomically(
        do_export_progsnap2 if progsnap2 else do_export,
        repo,
        output.resolve(),
    )

    typer.echo(f"Exported to {output}")
@

Both formats go out through [[write_export_atomically]]
(\cref{sec:staged-export}) rather than only the bundle, because both
land in the work tree and a half-written ProgSnap2 zip is no better a
thing to commit than a half-written bundle.
Choosing the writer before staging, rather than staging inside each
writer, also keeps the rule where a reader can see it: everything this
command writes appears at its destination in one step.

