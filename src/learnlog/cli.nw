def test_play_colour_follows_the_flags(workdir, monkeypatch):
    """--no-color strips escapes, --color forces them."""
    from learnlog.cli import app
    from typer.testing import CliRunner
    repo = LearnlogRepo(workdir)
    (workdir / "hello.py").write_text('print("hi")\n')
    repo.begin_run(
        "hello.py", [],
        datetime.datetime(2026, 1, 1, 10, 0),
    )
    runner = CliRunner()
    monkeypatch.delenv("NO_COLOR", raising=False)

    plain = runner.invoke(
        app, ["play", "--no-color", "--from", str(workdir)]
    )
    assert plain.exit_code == 0
    assert "\x1b[" not in plain.output

    default = runner.invoke(
        app, ["play", "--from", str(workdir)]
    )
    assert "\x1b[" not in default.output

    coloured = runner.invoke(
        app, ["play", "--color", "--from", str(workdir)]
    )
    assert coloured.exit_code == 0
    assert "\x1b[32m" in coloured.output

    monkeypatch.setenv("NO_COLOR", "1")
    assert "\x1b[" not in runner.invoke(
        app, ["play", "--from", str(workdir)]
    ).output
    assert "\x1b[32m" in runner.invoke(
        app, ["play", "--color", "--from", str(workdir)]
    ).output
