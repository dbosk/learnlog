def test_next_run_after_checkout_is_charged_only_its_edit(
    workdir, monkeypatch,
):
    """The run after a checkout continues in line, with clean churn."""
    from learnlog.cli import app
    from learnlog.metrics import run_records
    from typer.testing import CliRunner
    repo = LearnlogRepo(workdir)
    branch = repo.recording_branch()
    monkeypatch.chdir(workdir)
    runner = CliRunner()
    old = _record_run(
        repo, 'print("v1")\n', datetime.datetime(2026, 1, 1, 10, 0),
    )
    _record_run(
        repo, 'print("v2")\nprint("v2")\nprint("v2")\n',
        datetime.datetime(2026, 1, 1, 10, 5),
    )

    result = runner.invoke(app, ["checkout", old[:7]])
    assert result.exit_code == 0, result.output
    trailer = repo.git("rev-parse", branch).stdout.strip()

    header = _record_run(
        repo, 'print("v1")\nprint("one more")\n',
        datetime.datetime(2026, 1, 1, 10, 10),
    )
    assert repo.git(
        "rev-parse", f"{header}^",
    ).stdout.strip() == trailer
    record = run_records(repo)[-1]
    assert (record.lines_added, record.lines_removed) == (1, 0)

    listing = runner.invoke(app, ["list"])
    assert listing.exit_code == 0, listing.output
    entries = [
        l for l in listing.output.splitlines()
        if l.startswith("  ")
    ]
    assert any(f"learnlog checkout {old[:7]}" in l for l in entries)
    assert entries.index(
        next(l for l in entries if "learnlog checkout" in l)
    ) == len(entries) - 2

