Let's verify the scenario itself on a log built by hand: three runs,
a playback whose trace ends on the middle one, then a checkout and a
fourth run after it.
The viewer must open on the middle run, not on the newest record, and
batch mode must print from there---the first run is before the
bookmark and stays out, the fourth is after it and comes along.
The interactive half calls the command as a function with the viewer
replaced, for the reason [[test_play_opens_on_the_newest_record]]
gives; the batch half goes through [[CliRunner]]:

<<test functions>>=
def _log_with_a_playback(workdir):
    """Four runs of hello.py with a playback that stopped on the
    second, and a checkout after it.  Returns the four hashes."""
    repo = LearnlogRepo(workdir)
    script = workdir / "hello.py"
    hashes = []
    t = datetime.datetime(2026, 1, 1, 10, 0)
    for n in range(3):
        script.write_text(f'print("run {n}")\n')
        repo.begin_run("hello.py", [], t.replace(minute=n))
        hashes.append(repo.run_commit)
    first, second, third = hashes
    repo.begin_run("learnlog", ["play"], t.replace(minute=10))
    repo.finalize_run(
        io_log="",
        exception_info=None,
        end_time=t.replace(minute=12),
        exit_code=0,
        view_trace=[
            (t.replace(minute=11, second=0), third, "open"),
            (t.replace(minute=11, second=1), first, "prev"),
            (t.replace(minute=11, second=2), second, "next"),
        ],
    )
    repo.begin_run(
        "learnlog", ["checkout", first[:7]], t.replace(minute=20),
    )
    script.write_text('print("run 3")\n')
    repo.begin_run("hello.py", [], t.replace(minute=30))
    hashes.append(repo.run_commit)
    return hashes

def test_play_continue_opens_where_the_last_playback_stopped(
    workdir, monkeypatch,
):
    import learnlog.cli as cli
    from learnlog.cli import app
    from typer.testing import CliRunner
    first, second, third, fourth = _log_with_a_playback(workdir)
    monkeypatch.chdir(workdir)
    opened = []

    class FakeViewer:
        def __init__(self, repo, commits, start_index,
                     *args, **kwargs):
            opened.append((commits, start_index))

        def run(self):
            pass

    monkeypatch.setattr(cli, "PlaybackViewer", FakeViewer)
    cli.play(source=str(workdir), batch=False, resume=True)
    commits, index = opened[-1]
    assert commits[index]["hash"] == second
    assert index < len(commits) - 1

    runner = CliRunner()
    result = runner.invoke(
        app, ["play", "-c", "--raw", "--from", str(workdir)],
    )
    assert result.exit_code == 0
    shown = re.findall(r"^commit ([0-9a-f]{40})$", result.output, re.M)
    assert shown[0] == second
    assert first not in shown
    assert fourth in shown
