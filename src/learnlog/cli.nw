def test_play_opens_on_the_newest_record(workdir, monkeypatch):
    """Without a ref the viewer opens on the last listed record."""
    import learnlog.cli as cli
    repo = LearnlogRepo(workdir)
    t1 = datetime.datetime(2026, 1, 1, 10, 0)
    repo.begin_run("hello.py", [], t1)
    repo.begin_run("learnlog", ["play"], t1)
