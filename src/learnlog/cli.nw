def test_record_index_three_answers():
    from learnlog.cli import record_index
    commits = [{"hash": "aaa"}, {"hash": "bbb"}, {"hash": "ccc"}]
    records = [commits[0], commits[2]]
    assert record_index(
        records, commits, lambda c: c["hash"] == "ccc", "missing",
    ) == 1
    with pytest.raises(SystemExit) as caught:
