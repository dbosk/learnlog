class MetricsInputs:
    """What every metrics command needs, plus its cleanup."""

    def __init__(self, repo, tmpdir, buckets, idle, header, by):
        self.repo = repo
        self.tmpdir = tmpdir
        self.buckets = buckets
        self.idle = idle
        self.header = header
        self.by = by
        self.snapshot_root = None

    def snapshot(self, bucket):
        """The directory holding the code to measure for `bucket`.

        One window measures the working tree as it is; a series
        extracts the tree of each bucket's last run.
        """
        if self.by is None:
            return self.repo.workdir
        if self.snapshot_root is None:
            self.snapshot_root = tempfile.mkdtemp(prefix="learnlog-")
        return bucket_snapshot(self.repo, bucket, self.snapshot_root)

    def cleanup(self):
        """Remove the temporary checkout and snapshots, if any."""
        for path in (self.tmpdir, self.snapshot_root):
            if path is not None:
                shutil.rmtree(path, ignore_errors=True)
