Refusals must come before the record: a name that is not in the log,
a commit that exists but not on the branch, and an unfinished merge
all leave the history and the files exactly as they were.

<<test functions>>=
def test_checkout_refuses_what_is_not_in_the_log(
    workdir, monkeypatch,
):
    """Unknown refs and off-branch commits change nothing."""
    from learnlog.cli import app
    from typer.testing import CliRunner
    repo = LearnlogRepo(workdir)
    branch = repo.recording_branch()
    monkeypatch.chdir(workdir)
    runner = CliRunner()
    _record_run(
        repo, 'print("v1")\n', datetime.datetime(2026, 1, 1, 10, 0),
    )
    (workdir / "hello.py").write_text('print("v2, never run")\n')
    stray = repo.git(
        "commit-tree", f"{branch}^{{tree}}", input="stray\n",
    ).stdout.strip()
    before = repo.git("rev-parse", branch).stdout.strip()

    for ref in ("nonesuch", stray):
        result = runner.invoke(app, ["checkout", ref])
        assert result.exit_code == 1, result.output
        assert "not a run in this log" in result.output
    assert repo.git("rev-parse", branch).stdout.strip() == before
    assert (workdir / "hello.py").read_text() == \
        'print("v2, never run")\n'

def test_checkout_refuses_during_an_unfinished_merge(
    workdir, monkeypatch,
):
    """A half-finished merge in the log stops the checkout."""
    from learnlog.cli import app
    from typer.testing import CliRunner
    repo = LearnlogRepo(workdir)
    branch = repo.recording_branch()
    monkeypatch.chdir(workdir)
    runner = CliRunner()
    old = _record_run(
        repo, 'print("v1")\n', datetime.datetime(2026, 1, 1, 10, 0),
    )
    (workdir / ".learnlog" / "MERGE_HEAD").write_text(old + "\n")
    before = repo.git("rev-parse", branch).stdout.strip()

    result = runner.invoke(app, ["checkout", old[:7]])
    assert result.exit_code == 1, result.output
    assert "MERGE_HEAD" in result.output
    assert repo.git("rev-parse", branch).stdout.strip() == before
