    )
    before = cloned.git("rev-parse", "HEAD").stdout.strip()
    monkeypatch.chdir(workdir)
    (workdir / "hello.py").write_text('print("theirs")\n')
    repo.begin_run(
        "hello.py", [], datetime.datetime(2026, 1, 1, 12, 0),
    )
    runner.invoke(app, ["push"])

    monkeypatch.chdir(target)
    result = runner.invoke(app, ["pull"])

    assert result.exit_code != 0
    assert "conflict" in result.output.lower()
    assert student.read_text() == 'print("mine")\n'
