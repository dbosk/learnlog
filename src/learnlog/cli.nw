def test_play_keeps_student_run_intact(workdir):
    """A learnlog run overlapping a student run stays separate.

    The student starts a program; while it runs, ``learnlog
    play`` is invoked and finishes first.  The student's output
    must be attributed to the student's run---each record keeps
    its own I/O rather than absorbing the other's.  The test is
    about attribution, so it asks for ``--all`` to get both
    records on screen to compare.
    """
    from learnlog.cli import app
    from typer.testing import CliRunner
    student = LearnlogRepo(workdir)
    tool = LearnlogRepo(workdir)
    t1 = datetime.datetime(2026, 1, 1, 10, 0)
    student.begin_run("hello.py", [], t1)
    tool.begin_run("learnlog", ["play"], t1)
    tool.finalize_run(
        io_log="stdout: CURSES SCREEN\n",
        exception_info=None,
        end_time=datetime.datetime(2026, 1, 1, 10, 0, 1),
        exit_code=0,
    )
    student.finalize_run(
        io_log="stdout: hello\n",
        exception_info=None,
        end_time=datetime.datetime(2026, 1, 1, 10, 0, 2),
        exit_code=0,
    )
    runner = CliRunner()
    result = runner.invoke(
        app, ["play", "--all", "--from", str(workdir)]
    )
    assert result.exit_code == 0
    review_start = result.output.index(
        "You looked back through your log",
    )
    assert result.output.index("stdout: hello") < review_start
    assert result.output.index("CURSES SCREEN") > review_start

