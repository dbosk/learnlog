def test_checkout_restore_lists_and_undoes_a_checkout(
    workdir, monkeypatch,
):
    from learnlog.cli import app
    from typer.testing import CliRunner
    repo = LearnlogRepo(workdir)
    branch = repo.recording_branch()
    t = datetime.datetime(2026, 1, 1, 10, 0)
    old = _record_run(repo, 'print("v1")\n', t)
    newer = _record_run(repo, 'print("v2")\n', t.replace(minute=5))
    monkeypatch.chdir(workdir)
    runner = CliRunner()
    assert runner.invoke(app, ["checkout", old[:7]]).exit_code == 0
    _record_run(repo, 'print("v1 edited")\n', t.replace(minute=10))
    assert runner.invoke(app, ["checkout", newer[:7]]).exit_code == 0
    (workdir / "hello.py").write_text('print("v2 edited")\n')
    before = repo.git("rev-list", branch).stdout.split()

    result = runner.invoke(app, ["checkout", "--restore"], input="2\n")
    assert result.exit_code == 0, result.output
    lines = result.output.splitlines()
    assert lines[0] == "Your checkouts, newest first:"
    assert f"learnlog checkout {newer[:7]}" in lines[1]
    assert f"learnlog checkout {old[:7]}" in lines[2]
    assert "files before it:" in lines[1]
    assert (workdir / "hello.py").read_text() == 'print("v2")\n'
    after = repo.git("rev-list", branch).stdout.split()
    assert after[2:] == before
    assert repo.git(
        "log", "-1", "--format=%s", f"{branch}~1",
    ).stdout.strip() == "Run: learnlog checkout --restore 2"
    assert repo.git(
        "show", f"{branch}~1:hello.py",
    ).stdout == 'print("v2 edited")\n'

    result = runner.invoke(app, ["checkout", "--restore", "1"])
    assert result.exit_code == 0, result.output
    assert "--restore 2" in result.output.splitlines()[1]
    assert len(result.output.splitlines()) >= 4
    assert (workdir / "hello.py").read_text() == 'print("v2 edited")\n'
    assert repo.git("rev-list", branch).stdout.split()[2:] == after

    result = runner.invoke(app, ["checkout", "--restore", "9"])
    assert result.exit_code == 1
    assert "no checkout 9" in result.output
    result = runner.invoke(app, ["checkout", "--restore", "x"])
    assert result.exit_code == 1
    assert "not the number of a checkout" in result.output
    result = runner.invoke(app, ["checkout", "--restore"])
    assert result.exit_code == 0, result.output
    assert "taking 1" in result.output

def test_checkout_restore_refuses_other_shapes(workdir, monkeypatch):
