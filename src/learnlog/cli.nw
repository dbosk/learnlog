def test_getting_started_reactivates_and_checks_playback():
    """Later shell steps pre-activate the venv and require playback."""
    from importlib import resources

    from pytorial.catalog import parse_tutorial_text

    tutorial_path = resources.files("learnlog") / "tutorials"
    tutorial_path = tutorial_path / "getting-started.md"
