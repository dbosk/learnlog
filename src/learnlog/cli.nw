def emit_metrics(inputs, results, columns, fmt, extra_header=()):
    """Render and print one report, or say the series is empty."""
    if not results:
        typer.echo("No runs in this window.")
        return
    header = [*inputs.header, *extra_header]
    typer.echo(render(results, columns, fmt, header), nl=False)
