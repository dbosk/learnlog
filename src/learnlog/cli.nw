    purelib = tmp_path / "site-packages"
    purelib.mkdir()
    marker = purelib / "learnlog_project_root.txt"
    marker.write_text(str(tmp_path / "deleted-lab") + "\n")
    state, lines = autostart_report(
        marker_path=marker,
        sys_prefix=str(tmp_path / "nowhere" / ".venv"),
    )
    assert state is AutostartState.dead
    assert any(
        str(tmp_path / "deleted-lab") in line for line in lines
    )

