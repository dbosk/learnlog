    from learnlog.cli import app
    from typer.testing import CliRunner

    result = CliRunner().invoke(app, ["tutorial", "list"])
    out = result.stdout

    assert result.exit_code == 0
    assert "getting-started" in out
    assert "playback-and-tagging" in out
    assert "export-and-share" in out
    assert "analysing-progsnap2" in out
    assert (
        out.index("getting-started")
        < out.index("playback-and-tagging")
        < out.index("export-and-share")
        < out.index("analysing-progsnap2")
    )

