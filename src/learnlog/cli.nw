def default_output(source):
    """The directory a copy from ``source`` goes into by default."""
    name = pathlib.Path(source).resolve().name
    for suffix in (BUNDLE_SUFFIX, PROGSNAP2_SUFFIX):
        if name.endswith(suffix):
            name = name[:-len(suffix)]
    return name or "."
