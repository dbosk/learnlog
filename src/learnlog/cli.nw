def test_clean_ignored_only_detection():
    """-X is recognised bundled, but not as an -e pattern."""
    from learnlog.cli import clean_removes_ignored_only
    assert clean_removes_ignored_only(["-Xdf"])
    assert clean_removes_ignored_only(["-d", "-X"])
    assert not clean_removes_ignored_only(["-xdf"])
    assert not clean_removes_ignored_only(["-xdf", "-e", "X"])
    assert not clean_removes_ignored_only(["-xdf", "-eX"])
    assert not clean_removes_ignored_only(["-xdf", "--", "-X"])

