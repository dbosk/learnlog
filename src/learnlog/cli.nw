def test_pull_with_unreadable_tip_refuses_plainly(
    workdir, monkeypatch,
):
    """A branch with no readable tip gets a sentence."""
    from learnlog import gitrepo
    from learnlog.cli import app
    from typer.testing import CliRunner
    LearnlogRepo(workdir)
    runner = CliRunner()
    target = _two_machine_log(workdir, runner, monkeypatch)

    real_git = gitrepo.LearnlogRepo.git

    def failing_local_probe(self, *args, **kwargs):
        if (
            args[:3] == ("rev-parse", "--verify", "--quiet")
            and args[3].startswith("refs/heads/")
        ):
            result = real_git(
                self, "rev-parse", "--verify", "--quiet",
                "refs/heads/no-such-branch", check=False,
            )
            return result
        return real_git(self, *args, **kwargs)

    monkeypatch.setattr(
        gitrepo.LearnlogRepo, "git", failing_local_probe,
    )
    monkeypatch.chdir(target)
    result = runner.invoke(app, ["pull"])

    assert result.exit_code != 0
    assert "no commits to pull onto" in result.output
    if result.exception is not None:
        assert isinstance(result.exception, SystemExit)
