<<test functions>>=
def test_tag_filter():
    from learnlog.cli import tag_filter
    assert tag_filter(False, None) is None
    anything = tag_filter(True, None)
    assert anything(["lab1"]) and not anything([])
    lecture = tag_filter(True, "lecture")
    assert lecture(["lab1", "lecture21"])
    assert not lecture(["lab1"])
    exact = tag_filter(True, "^lab1$")
