    activate = venv_dir / "bin" / "activate"
    activate.parent.mkdir(parents=True)
    activate.write_text("")
    assert emit_activate_shell_code(venv_dir, Shell.bash) == (
        f"source {shlex.quote(str(activate))}"
    )
