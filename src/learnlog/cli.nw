    venv_dir = workdir / ".venv"
    venv_dir.mkdir()
    assert resolve_project_venv(workdir) == venv_dir.resolve()

def test_resolve_project_venv_errors_when_missing(workdir):
    """A learnlog project without .venv/ is rejected."""
