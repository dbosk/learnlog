    """Bash activation uses .venv/bin/activate."""
    from learnlog.cli import Shell, activation_script
    repo = LearnlogRepo(workdir)
    activate = workdir / ".venv" / "bin" / "activate"
    activate.parent.mkdir(parents=True)
    activate.write_text("")
