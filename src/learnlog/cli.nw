Let's verify the commands end to end on a small history: a
[[NameError]], the same error after an edit, then a clean run.
The runs are dated in January so that only [[--period all]] or an
explicit window reaches them, which is also what makes the
[[--period]]/[[--since]] refusal testable.

<<test functions>>=
def _metrics_history(workdir):
    repo = LearnlogRepo(workdir)
    trace = (
        "Traceback (most recent call last):\n"
        '  File "hello.py", line 1, in <module>\n'
        "NameError: name 'x' is not defined"
    )
    (workdir / "hello.py").write_text("print(x)\n")
    for minute, source, exc, code in [
        (0, "print(x)\n", trace, 1),
        (5, "print(x)  # again\n", trace, 1),
        (9, "x = 1\nprint(x)\n", None, 0),
    ]:
        (workdir / "hello.py").write_text(source)
        start = datetime.datetime(2026, 1, 5, 10, minute)
        repo.begin_run("hello.py", [], start)
        repo.finalize_run(
            io_log="", exception_info=exc,
            end_time=start + datetime.timedelta(seconds=2),
            exit_code=code,
        )
    return repo


def _metrics(args, workdir, env=None):
    from learnlog.cli import app
    from typer.testing import CliRunner
    return CliRunner().invoke(
        app, ["metrics", *args, "--from", str(workdir)], env=env,
    )


def test_metrics_time_and_eq(workdir):
    """time and eq print headers and the hand-computed values."""
    _metrics_history(workdir)
    result = _metrics(["time", "--period", "all"], workdir)
    assert result.exit_code == 0, result.output
    assert "idle threshold: 20 min" in result.output
    assert "active time (run-to-run)" in result.output
    assert "0h 09m" in result.output
    result = _metrics(
        ["eq", "--period", "all", "--format", "json"], workdir,
    )
    assert result.exit_code == 0, result.output
    document = json.loads(result.output)
    assert any("two-parameter" in p for p in document["parameters"])
    row = document["rows"][0]
    assert row["pairs"] == 2
    assert row["eq_any"] == 0.5 and row["eq_syntax"] == 0.0
    assert row["red_any"] == 0.5


def test_metrics_code_and_lint(workdir, monkeypatch):
    """code measures the working tree; lint reports a missing linter."""
    _metrics_history(workdir)
    result = _metrics(["code", "--period", "all"], workdir)
    assert result.exit_code == 0, result.output
    assert "Maintainability index" in result.output
    result = _metrics(
        ["code", "--period", "all", "--format", "json"], workdir,
    )
    row = json.loads(result.output)["rows"][0]
    assert row["sloc"] == 2 and row["files"] == 1
    monkeypatch.setattr(
        "learnlog.metrics.shutil.which", lambda name: None,
    )
    monkeypatch.setattr("learnlog.metrics.INTERPRETER_BIN", workdir)
    result = _metrics(["lint", "--period", "all"], workdir)
    assert result.exit_code == 0, result.output
    assert "pip install ruff" in result.output


def test_metrics_linter_choice(workdir):
    """--linter beats the learnlog.linter setting, which beats ruff."""
    from learnlog.cli import app
    from typer.testing import CliRunner
    _metrics_history(workdir)

    def tool(*args):
        result = _metrics(
            ["lint", "--period", "all", "--format", "json", *args],
            workdir,
        )
        assert result.exit_code == 0, result.output
        return json.loads(result.output)["rows"][0]["lint_tool"]

    def config(*args):
        return CliRunner().invoke(
            app, ["config", "linter", *args, "--dir", str(workdir)],
        )

    assert tool() == "ruff"
    assert tool("--linter", "pylint") == "pylint"
    assert "not set" in config().output
    assert config("pylint").exit_code == 0, config("pylint").output
    assert config().output.strip() == "pylint"
    assert tool() == "pylint"
    assert tool("--linter", "ruff") == "ruff"
    assert config("flake8").exit_code != 0
    assert config("--unset").exit_code == 0
    assert tool() == "ruff"


def test_metrics_trends_and_window_rules(workdir):
    """trends says when it is too early; conflicting windows refuse."""
    _metrics_history(workdir)
    result = _metrics(["trends", "--by", "day"], workdir)
    assert result.exit_code == 0, result.output
    assert "2026-01-05" in result.output
    assert "not enough days yet" in result.output
    result = _metrics(
        ["trends", "--by", "day", "--format", "json"], workdir,
    )
    assert json.loads(result.output)["trends"]
    result = _metrics(["time"], workdir)
    assert result.exit_code == 0
    assert "0 runs" in result.output
    result = _metrics(["time", "--period", "yesterday"], workdir)
    assert result.exit_code == 0, result.output
    assert "0 runs" in result.output
    result = _metrics(
        ["time", "--period", "all", "--since", "2026-01-01"], workdir,
    )
    assert result.exit_code != 0
    assert "cannot be combined" in result.output
    result = _metrics(
        ["eq", "--since", "2026-01-01", "--until", "2026-01-05"],
        workdir,
    )
    assert result.exit_code == 0, result.output
    assert "3 runs" in result.output
