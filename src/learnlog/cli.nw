The search reads the header messages out of one scan and the
trailer-to-header map out of the same scan, so aiming costs the two
Git calls the confirmation was already going to make and no more,
however many listings the student did before tagging.
A record counts as the student's when its message still has a run
block after the reading views' filter; the initial commit has none,
so it is never chosen and the fallback to HEAD covers it.

<<helper functions>>=
def bare_tag_form(args):
    """True for ``learnlog tag name``, the form the tutorial teaches."""
    return len(args) == 1 and not args[0].startswith("-")


def latest_student_commit(repo):
    """The newest commit that records the student's own work.

    Review runs and plumbing at the tip are skipped; a program
    run or a checkout is taken, as its trailer commit when the
    run finished and its header otherwise.  ``None`` when the
    log holds no such record.
    """
    scan = scan_run_commits(repo)
    trailer_of = {
        header: trailer for trailer, header in scan.records.items()
    }
    for commit in reversed(get_commits(repo)):
        message = scan.messages.get(commit["hash"], "")
        kept = filter_runs(message, is_hidden_command)
        if parse_run_summary(kept) is None:
            continue
        return trailer_of.get(commit["hash"], commit["hash"])
    return None
@

