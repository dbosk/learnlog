An inherited [[GIT_INDEX_FILE]] is the passthrough's version of the
hook scenario: were it forwarded, [[git add]] would write the index
at that path---the student's repository's---instead of the log's.
The hijacked path staying absent is the whole assertion, because Git
creates the file it is told to write:

<<test functions>>=
def test_git_command_ignores_inherited_index(
    workdir, monkeypatch, tmp_path,
):
    """A hook's GIT_INDEX_FILE does not reach the passthrough."""
    from learnlog.cli import app
    from typer.testing import CliRunner
    repo = LearnlogRepo(workdir)
    (workdir / "junk.txt").write_text("untracked\n")
    hijacked = tmp_path / "hijacked-index"
    monkeypatch.setenv("GIT_INDEX_FILE", str(hijacked))
    monkeypatch.chdir(workdir)
    result = CliRunner().invoke(app, ["git", "add", "."])
    assert result.exit_code == 0
    assert not hijacked.exists()
