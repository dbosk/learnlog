Interrupting the clone must leave the target as it was found, and the
moment worth interrupting is the one just after the repository has
been moved into place: that is where a partial [[.learnlog/]] would
survive, and a surviving [[.learnlog/]] is what makes the next attempt
refuse.
The command is called directly rather than through the runner, so the
interruption arrives as itself.

<<test functions>>=
def test_clone_interrupted_leaves_nothing_behind(
    workdir, pushed_log, monkeypatch,
):
    """A cancelled clone leaves no half-finished log."""
    from learnlog import cli
    target = workdir / "interrupted"
    target.mkdir()
    real_rename = cli.os.rename

    def rename_then_interrupt(source, destination):
        real_rename(source, destination)
        raise KeyboardInterrupt

    monkeypatch.setattr(
        cli.os, "rename", rename_then_interrupt,
    )
    with pytest.raises(KeyboardInterrupt):
        cli.clone(url=str(pushed_log), directory=target)
    assert list(target.iterdir()) == []
