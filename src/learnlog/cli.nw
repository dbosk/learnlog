case the substring match got wrong.

<<test functions>>=
def test_analyse_tag_filter_matches_whole_names(
    workdir, monkeypatch,
):
    """X-Tag=lab1 must not match lab10."""
    from learnlog.cli import app
    from learnlog.commits import get_commits
    from typer.testing import CliRunner
    repo = LearnlogRepo(workdir)
    for minute, version, tag in [
        (0, "v1", "lab1"), (5, "v2", "lab10"),
    ]:
        (workdir / "hello.py").write_text(
            f'print("{version}")\n'
        )
        start = datetime.datetime(2026, 1, 1, 10, minute)
        repo.begin_run("hello.py", [], start)
        repo.finalize_run(
            io_log=f"stdout: {version}\n",
            exception_info=None,
            end_time=start + datetime.timedelta(seconds=5),
            exit_code=0,
        )
        commits = get_commits(repo)
        repo.git("tag", tag, commits[-1]["hash"])
    monkeypatch.chdir(workdir)
    result = CliRunner().invoke(
        app, ["analyse", "X-Tag=lab1", "X-Tag=lab1"],
    )
    assert result.exit_code == 0, result.output
    assert "v1" in result.output
    assert "v2" not in result.output
