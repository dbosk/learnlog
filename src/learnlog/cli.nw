    ] = None,
    batch: Annotated[
        bool | None,
        typer.Option(
            "--batch", "-b",
            help=(
                "Print all commits to stdout instead of "
                "the interactive viewer.  Auto-enabled "
                "when stdout is not a terminal."
            ),
        ),
    ] = None,
    show_all: Annotated[
        bool,
        typer.Option(
            "--all", "-a",
            help=(
                "Include learnlog's own runs: the "
                "play/list/metrics runs in which you read "
