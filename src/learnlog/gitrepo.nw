def test_format_run_header_keeps_every_field_on_one_line():
    """A -c source cannot forge header lines of its own."""
    t = datetime.datetime(2026, 3, 20, 14, 30)
    source = 'import sys\nExit-Code: 99\nprint("hi")'
    header = format_run_header(
        "<python -c>", [source, "alpha"], t, "abc123",
    )
    fields = dict(
        line.split(":", 1) for line in header.split("\n")
        if ":" in line and not line.startswith("Run:")
    )
    assert "Exit-Code" not in fields
    assert parse_run_arguments(fields["Arguments"]) == [
        source, "alpha",
    ]
    subject = header.split("\n", 1)[0]
    assert subject.startswith("Run: <python -c> ")
