def test_run_arguments_round_trip_backslashes_and_returns():
    args = ["c:\\path\\n", "a\r\nb", "", "one two"]
    value = format_run_arguments(args)
    assert "\n" not in value and "\r" not in value
    assert parse_run_arguments(value) == args

def test_parse_run_arguments_tolerates_unquotable_text():
    """An old or hand-edited value degrades to a plain split."""
    assert parse_run_arguments("alpha 'beta") == ["alpha", "'beta"]
    assert parse_run_arguments("(none)") == []
    assert parse_run_arguments("") == []
@


\subsection{The header block}

<<functions>>=
def format_run_header(script, args, start_time,
                      run_id=None):
    """Format a run header block.

    The header records which script was run, its arguments, and
    the start time.  When ``run_id`` is given, it is recorded as
    the ``Run-Id`` field that links this run to its trailer.
    """
    args_str = format_run_arguments(args)
    lines = [
        f"Run: {script} {args_str}",
        "",
        f"Script: {script}",
        f"Arguments: {args_str}",
        f"Start-Time: {start_time.isoformat()}",
    ]
    if run_id:
        lines.append(f"{RUN_ID_FIELD} {run_id}")
    return "\n".join(lines)
<<constants>>=
RUN_ID_FIELD = "Run-Id:"
@

Let's verify the format:

