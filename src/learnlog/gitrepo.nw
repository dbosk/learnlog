<<test functions>>=
def test_begin_run_commits_on_file_change(workdir):
    repo = LearnlogRepo(workdir)
    (workdir / "hello.py").write_text('print("changed")\n')
    now = datetime.datetime.now()
    repo.begin_run("hello.py", [], now)
    result = repo.git("log", "--oneline")
    lines = result.stdout.strip().split("\n")
    assert len(lines) == 2  # initial + run

def test_begin_run_commits_without_file_change(workdir):
    """Unchanged code still gets its own header commit."""
    repo = LearnlogRepo(workdir)
    now = datetime.datetime.now()
    repo.begin_run("hello.py", [], now)
    result = repo.git("log", "--oneline")
    lines = result.stdout.strip().split("\n")
    assert len(lines) == 2  # initial + run

def test_begin_run_two_runs_two_commits(workdir):
    """Two runs of identical code are two separate records."""
    repo = LearnlogRepo(workdir)
    t1 = datetime.datetime(2026, 1, 1, 10, 0)
    t2 = datetime.datetime(2026, 1, 1, 10, 5)
    repo.begin_run("hello.py", [], t1)
    first = repo.git("rev-parse", "HEAD").stdout.strip()
    repo.begin_run("hello.py", ["--verbose"], t2)
    result = repo.git("log", "--oneline")
    lines = result.stdout.strip().split("\n")
    assert len(lines) == 3
    parent = repo.git(
