    repo.finalize_run(
        io_log="stdout: second\n",
        exception_info=None,
        end_time=datetime.datetime(2026, 1, 1, 10, 1, 1),
        exit_code=0,
    )
    msg = repo.git("log", "--format=%B").stdout
    assert msg.count("x") >= LARGE_IO_BYTES
    assert "Arguments: again" in msg
