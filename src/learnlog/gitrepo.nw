def test_runs_land_on_the_branch_from_a_detached_head(workdir):
    """A detached HEAD must not take the run's commits with it."""
    repo = LearnlogRepo(workdir)
    branch = repo.recording_branch()
    (workdir / "hello.py").write_text('print("v1")\n')
    repo.begin_run(
        "hello.py", [], datetime.datetime(2026, 1, 1, 10, 0),
    )
    repo.finalize_run(
        io_log="",
        exception_info=None,
        end_time=datetime.datetime(2026, 1, 1, 10, 0, 1),
        exit_code=0,
    )
    old = repo.git("rev-parse", "HEAD~2").stdout.strip()
    repo.git("checkout", "--detach", old)
    before = int(repo.git(
        "rev-list", "--count", branch,
    ).stdout.strip())

    detached = LearnlogRepo(workdir)
    detached.begin_run(
        "hello.py", [], datetime.datetime(2026, 1, 1, 11, 0),
    )
    run_id = detached.run_id
    detached.finalize_run(
        io_log="stdout: detached\n",
        exception_info=None,
        end_time=datetime.datetime(2026, 1, 1, 11, 0, 1),
        exit_code=0,
    )

    after = int(repo.git(
        "rev-list", "--count", branch,
    ).stdout.strip())
    assert after == before + 2
    pushable = repo.git(
        "log", "--branches", "--format=%B",
    ).stdout
    assert "stdout: detached" in pushable
    assert pushable.count(f"Run-Id: {run_id}") == 2
    assert repo.git("rev-parse", "HEAD").stdout.strip() == old
    assert repo.git(
        "symbolic-ref", "--quiet", "HEAD", check=False,
    ).returncode != 0
