def test_head_state_attached(workdir):
    """Attached HEAD yields both the tip and the branch."""
    repo = LearnlogRepo(workdir)
    tip, branch = repo.head_state()
    assert tip == repo.git("rev-parse", "HEAD").stdout.strip()
    assert branch == repo.recording_branch()
    assert branch.startswith("refs/heads/")

def test_head_state_detached(workdir):
    """Detached HEAD yields the tip and no branch."""
    repo = LearnlogRepo(workdir)
    commit = repo.git("rev-parse", "HEAD").stdout.strip()
    repo.git("checkout", "--detach", commit)
    assert repo.head_state() == (commit, None)

def test_head_state_unresolvable(workdir):
    """A HEAD that resolves to nothing yields neither."""
