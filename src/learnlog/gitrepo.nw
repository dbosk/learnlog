The interleaving from \cref{sec:two-commit-protocol} is the case the
old protocol corrupted: a logged program starts another logged program,
so the inner run finalises first.
Each run must still get its own results.

<<test functions>>=
def test_overlapping_runs_keep_their_own_results(workdir):
    """An inner run finalising first must not steal the trailer."""
    parent = LearnlogRepo(workdir)
    child = LearnlogRepo(workdir)
    t0 = datetime.datetime(2026, 1, 1, 10, 0)

    parent.begin_run("parent.py", [], t0)
    parent_id = parent.run_id
    child.begin_run("child.py", [], t0)
    child_id = child.run_id
    child.finalize_run(
        io_log="stdout: CHILD\n",
        exception_info=None,
        end_time=datetime.datetime(2026, 1, 1, 10, 0, 1),
        exit_code=0,
    )
    parent.finalize_run(
        io_log="stdout: PARENT\n",
        exception_info=None,
        end_time=datetime.datetime(2026, 1, 1, 10, 0, 2),
        exit_code=3,
    )

    child_trailer = _trailer_for(parent, child_id)
    parent_trailer = _trailer_for(parent, parent_id)
    assert "stdout: CHILD" in child_trailer
    assert "Exit-Code: 0" in child_trailer
    assert "stdout: PARENT" in parent_trailer
    assert "Exit-Code: 3" in parent_trailer
