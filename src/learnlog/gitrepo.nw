    repo.begin_run(
        "hello.py", [], datetime.datetime(2026, 1, 1, 10, 1),
    )
    assert repo.git(
        "show", "HEAD:hello.py",
    ).stdout == 'print("while reviewing")\n'
    assert repo.git(
        "log", "-1", "--format=%s",
    ).stdout.strip() == "Run: hello.py (none)"
@

The interleaving from \cref{sec:two-commit-protocol} is the case the
old protocol corrupted: a logged program starts another logged program,
so the inner run finalises first.
Each run must still get its own results.

<<test functions>>=
def test_overlapping_runs_keep_their_own_results(workdir):
    """An inner run finalising first must not steal the trailer."""
    parent = LearnlogRepo(workdir)
    child = LearnlogRepo(workdir)
    t0 = datetime.datetime(2026, 1, 1, 10, 0)

    parent.begin_run("parent.py", [], t0)
    parent_id = parent.run_id
    child.begin_run("child.py", [], t0)
    child_id = child.run_id
    child.finalize_run(
        io_log="stdout: CHILD\n",
        exception_info=None,
        end_time=datetime.datetime(2026, 1, 1, 10, 0, 1),
        exit_code=0,
    )
    parent.finalize_run(
        io_log="stdout: PARENT\n",
        exception_info=None,
        end_time=datetime.datetime(2026, 1, 1, 10, 0, 2),
        exit_code=3,
    )

    child_trailer = _trailer_for(parent, child_id)
    parent_trailer = _trailer_for(parent, parent_id)
    assert "stdout: CHILD" in child_trailer
    assert "Exit-Code: 0" in child_trailer
    assert "stdout: PARENT" in parent_trailer
    assert "Exit-Code: 3" in parent_trailer
@

The helper looks for the trailer commit that names a given run id,
which is the same join the readers in \cref{commits} perform---spelled
out here so this test verifies the recorded data rather than the code
that reads it back:

<<test functions>>=
def _trailer_for(repo, run_id):
    """Return the trailer commit message naming ``run_id``."""
    hashes = repo.git("log", "--format=%H").stdout.split()
    for commit_hash in hashes:
        message = repo.git(
            "log", "-1", "--format=%B", commit_hash,
        ).stdout
        if message.startswith("Run-End:") and \
                run_id in message:
            return message
    return ""
@

The regression test for the argument-size limit uses 300\,KB of I/O:
comfortably past the 128\,KiB cap, and comfortably under
[[MAX_IOLOG_BYTES]], so it is a size a real program can reach.
The second run afterwards checks that a loud run does not disturb the
records around it; both records are read from the whole log, since
each run is a header and a trailer commit
(\cref{sec:two-commit-protocol}):

<<test functions>>=
LARGE_IO_BYTES = 300_000

def test_finalize_survives_io_beyond_argv_limit(workdir):
    repo = LearnlogRepo(workdir)
    repo.begin_run(
        "hello.py", [], datetime.datetime(2026, 1, 1, 10, 0)
    )
    io_log = "x" * LARGE_IO_BYTES + "\nstdout: TAIL\n"
    repo.finalize_run(
        io_log=io_log,
        exception_info=None,
        end_time=datetime.datetime(2026, 1, 1, 10, 0, 5),
        exit_code=7,
    )
    msg = repo.git("log", "-1", "--format=%B").stdout
    assert "End-Time: 2026-01-01T10:00:05" in msg
    assert "Exit-Code: 7" in msg
    assert "stdout: TAIL" in msg
    assert msg.count("x") >= LARGE_IO_BYTES

def test_run_after_large_run_keeps_both(workdir):
    repo = LearnlogRepo(workdir)
    repo.begin_run(
        "hello.py", [], datetime.datetime(2026, 1, 1, 10, 0)
    )
    repo.finalize_run(
        io_log="x" * LARGE_IO_BYTES,
        exception_info=None,
        end_time=datetime.datetime(2026, 1, 1, 10, 0, 5),
        exit_code=0,
    )
    repo.begin_run(
        "hello.py", ["again"],
        datetime.datetime(2026, 1, 1, 10, 1),
