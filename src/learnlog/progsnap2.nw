The escaping names are what the guard exists for.
We give the restorer a working directory with a sibling next to it and
ask it to write over that sibling three ways---upwards, upwards via a
subdirectory that does not exist, and sideways with a Windows drive
letter.
Nothing outside the working directory may appear or change, the
legitimate entry must still restore, and each refusal must be audible:

<<progsnap2 test functions>>=
def test_restore_code_state_refuses_escaping_names(
    tmp_path, capsys,
):
    from learnlog.progsnap2 import restore_code_state

    workdir = tmp_path / "work"
    workdir.mkdir()

    restore_code_state(workdir, {
        "../escaped.py": "print('escaped')\n",
        "a/../../escaped.py": "print('escaped')\n",
        "C:/escaped.py": "print('escaped')\n",
        "pkg/main.py": "print('main')\n",
    })

    assert [p.name for p in tmp_path.iterdir()] == ["work"]
    assert not (workdir / "C:").exists()
    assert (workdir / "pkg" / "main.py").read_text() == \
        "print('main')\n"
    assert capsys.readouterr().err.count("escaped.py") == 3
