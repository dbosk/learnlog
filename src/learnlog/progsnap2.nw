        rebuild_io_log, rebuild_view_trace,
    )
    events = [
        {
            "EventType": "X-Run.Output", "EventID": "2",
            "Order": "2", "ParentEventID": "1",
            "ServerTimestamp": "2026-01-01T10:00:02",
            "ProgramOutput": "Resources/io_2.txt",
        },
        {
            "EventType": "X-Review.View", "EventID": "3",
            "Order": "3", "ParentEventID": "1",
            "ServerTimestamp": "2026-01-01T10:00:03",
            "X-ViewedCommit": "e" * 40,
