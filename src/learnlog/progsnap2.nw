Finally we round-trip a real repository through ProgSnap2,
reconstruct it, and verify that playback-oriented Git features
still work: commit count, tags, commit messages, and deleted
files.

The first run's record is the \emph{second} commit: the initial
snapshot stands on its own, since no run is folded into it any more
(\cref{sec:two-commit-protocol}).
The tag is worth watching too---it was created while HEAD was a
trailer commit, so it only survives the round trip because
[[get_tag_map]] reports it on the run's header commit.

<<progsnap2 test functions>>=
def test_read_progsnap2_as_repo_roundtrip(workdir):
    import shutil
    from learnlog.commits import get_commits
    from learnlog.progsnap2 import (
        do_export_progsnap2,
        read_progsnap2_as_repo,
    )

    repo = LearnlogRepo(workdir)
    t1 = datetime.datetime(2026, 1, 1, 10, 0)
    repo.begin_run("hello.py", ["--name", "Alice"], t1)
    repo.finalize_run(
        io_log=(
            "stdout: Enter name:\n"
            "stdin: Alice\n"
            "stderr: warning\n"
            "stdout: Hello Alice\n"
        ),
        exception_info="ValueError: bad input",
        end_time=datetime.datetime(2026, 1, 1, 10, 0, 5),
        exit_code=1,
    )
    repo.git("tag", "lab1")

    (workdir / "hello.py").unlink()
    (workdir / "main.py").write_text("print('main')\n")
    t2 = datetime.datetime(2026, 1, 1, 10, 5)
    repo.begin_run("main.py", [], t2)
    repo.finalize_run(
        io_log="stdout: ok\n",
        exception_info=None,
        end_time=datetime.datetime(2026, 1, 1, 10, 5, 1),
        exit_code=0,
    )

    original_commits = get_commits(repo)
    output = workdir / "roundtrip.progsnap2"
    do_export_progsnap2(repo, output)

    reconstructed, tmpdir = read_progsnap2_as_repo(output)
    try:
        rebuilt_commits = get_commits(reconstructed)
        assert len(rebuilt_commits) == len(original_commits)

        tag_target = reconstructed.git(
            "rev-parse", "lab1"
        )
        assert tag_target.returncode == 0

        first_message = reconstructed.git(
            "log", "-1", "--format=%B",
            rebuilt_commits[1]["hash"],
        )
        assert first_message.returncode == 0
        assert "Run: hello.py --name Alice" in \
            first_message.stdout
        assert "Exit-Code: 1" in first_message.stdout
        assert "End-Time: 2026-01-01T10:00:05" in \
            first_message.stdout
        assert "stdout: warning" in first_message.stdout
        assert "ValueError: bad input" in first_message.stdout

        status = reconstructed.git("show", "HEAD:main.py")
        assert status.returncode == 0
        missing = reconstructed.git(
            "show", "HEAD:hello.py", check=False
        )
        assert missing.returncode != 0
    finally:
        shutil.rmtree(tmpdir, ignore_errors=True)
@

What a round trip must not quietly change is which files the code
state contained.
A dataset old enough to predate learnlog's export patterns can carry
a file named like one of learnlog's own exports---the student
downloaded a classmate's dataset into the project directory, and the
run that followed committed it---and importing such a dataset into a
repository that now excludes those names used to drop the file
without saying so.
The test builds that history the only way the current recorder can:
by staging the file explicitly, which is what an older learnlog did
by default.

Its second assertion is the other half of forcing the add.
[[-f]] overrides every exclude pattern, and one of them is the
repository's own Git directory (\cref{sec:reconstruction-staging}), so
a reconstruction that forces without excluding it commits [[HEAD]] and
the object store as project files.

<<progsnap2 test functions>>=
def test_read_progsnap2_as_repo_keeps_export_named_file(workdir):
    """An export-named file in a code state survives import."""
    import shutil
    from learnlog.progsnap2 import (
        do_export_progsnap2,
        read_progsnap2_as_repo,
    )

    (workdir / "handout.progsnap2").write_text("classmate\n")
    repo = LearnlogRepo(workdir)
    repo.git("add", "-f", "handout.progsnap2")
    repo.begin_run(
        "hello.py", [], datetime.datetime(2026, 1, 1, 10, 0),
    )
    repo.finalize_run(
        io_log="stdout: hi\n",
        exception_info=None,
        end_time=datetime.datetime(2026, 1, 1, 10, 0, 1),
        exit_code=0,
    )
    assert "handout.progsnap2" in repo.git(
        "ls-tree", "-r", "--name-only", "HEAD",
    ).stdout

    output = workdir / "old.progsnap2"
    do_export_progsnap2(repo, output)

    reconstructed, tmpdir = read_progsnap2_as_repo(output)
    try:
        tracked = reconstructed.git(
            "ls-tree", "-r", "--name-only", "HEAD",
        ).stdout.split("\n")
        assert "handout.progsnap2" in tracked
        assert not [
            name for name in tracked
            if name.startswith(".learnlog/")
        ]
    finally:
        shutil.rmtree(tmpdir, ignore_errors=True)
@

Every test above receives the temporary directory and frees it
itself, which is the successful path and says nothing about the
failing one.
For that we interrupt the replay at [[restore_code_state]]---the
first thing the loop does per commit, so the repository exists and
the reconstruction is genuinely under way---and then look at where
[[mkdtemp]] would have put the directory.
That location is ours for the duration of the test, so the
assertion is about an otherwise empty directory rather than about a
[[/tmp]] full of other people's files, and the test can tell
\enquote{cleaned up} from \enquote{someone else cleaned up}.
Raising [[KeyboardInterrupt]] rather than a plain [[Exception]] is
the point of the test: the old handler caught the latter and would
still pass, which is how the leak survived the tests it had.

<<progsnap2 test functions>>=
def test_read_progsnap2_as_repo_cleans_up_on_interrupt(
    workdir, monkeypatch,
):
    """Ctrl-C mid-reconstruction leaves no temp repository."""
    import tempfile
    from learnlog import progsnap2
    from learnlog.progsnap2 import (
        do_export_progsnap2,
        read_progsnap2_as_repo,
    )

    repo = LearnlogRepo(workdir)
    moment = datetime.datetime(2026, 1, 1, 10, 0)
    repo.begin_run("hello.py", [], moment)
    repo.finalize_run(
        io_log="stdout: hello\n",
        exception_info=None,
        end_time=moment,
        exit_code=0,
    )
    output = workdir / "interrupted.progsnap2"
    do_export_progsnap2(repo, output)

    scratch = workdir.parent / "ps2-reconstruct-tmp"
    scratch.mkdir()
    monkeypatch.setattr(tempfile, "tempdir", str(scratch))

    def interrupt(*args, **kwargs):
        raise KeyboardInterrupt

    monkeypatch.setattr(
        progsnap2, "restore_code_state", interrupt
    )

    with pytest.raises(KeyboardInterrupt):
        read_progsnap2_as_repo(output)

    assert list(scratch.glob("learnlog-ps2-play-*")) == []
