A review run has to make the same journey.
The test below follows one out through the export and back in through
the reconstruction, and then reads the rebuilt repository the way
[[list]] and [[play]] read it---through [[filter_internal_runs]] and
[[parse_commit_runs]]---rather than by matching the message text.
That is the property that matters: not that the [[Viewed:]] lines came
back as characters, but that a reader arriving at the reconstructed log
with no knowledge of ProgSnap2 finds a review run with its trace,
indistinguishable from the one the student actually recorded.
Listing the blocks the parser found, rather than searching them for a
string, is also what catches the opposite failure: a child event turned
into a block of its own would show up here as a third run nobody
performed.

<<progsnap2 test functions>>=
def test_reconstruction_keeps_review_events(workdir):
    """A review run and its view trace survive the round trip."""
    import shutil
    from learnlog.commits import (
        filter_internal_runs, get_commits,
    )
    from learnlog.progsnap2 import (
        do_export_progsnap2,
        parse_commit_runs,
        read_progsnap2_as_repo,
    )
    repo = LearnlogRepo(workdir)
    seen = "d" * 40
    t1 = datetime.datetime(2026, 1, 1, 10, 0)
    repo.begin_run("hello.py", [], t1)
    repo.finalize_run(
        io_log="stdout: hello\n",
        exception_info=None,
        end_time=datetime.datetime(2026, 1, 1, 10, 0, 1),
        exit_code=0,
    )
    t2 = datetime.datetime(2026, 1, 1, 10, 5)
    repo.begin_run("learnlog", ["play"], t2)
    repo.finalize_run(
        io_log="",
        exception_info=None,
        end_time=datetime.datetime(2026, 1, 1, 10, 5, 30),
        exit_code=0,
        view_trace=[
            (datetime.datetime(2026, 1, 1, 10, 5, 2),
             seen, "open"),
            (datetime.datetime(2026, 1, 1, 10, 5, 8),
             seen, "next"),
        ],
    )

    output = workdir / "review.progsnap2"
    do_export_progsnap2(repo, output)
    reconstructed, tmpdir = read_progsnap2_as_repo(output)
    try:
        blocks = []
        for commit in get_commits(reconstructed):
            message = reconstructed.git(
                "log", "-1", "--format=%B", commit["hash"],
            ).stdout
            blocks.extend(parse_commit_runs(
                filter_internal_runs(message)
            ))
        assert [block["script"] for block in blocks] == [
            "hello.py", "learnlog",
        ]
        review = blocks[1]
        assert review["arguments"] == "play"
        assert review["viewed"] == [
            (seen, "2026-01-01T10:05:02", "open"),
            (seen, "2026-01-01T10:05:08", "next"),
        ]
        assert review["exit_code"] == "0"
        assert review["end_time"] == "2026-01-01T10:05:30"
        assert review["io_log"] is None
    finally:
        shutil.rmtree(tmpdir, ignore_errors=True)
