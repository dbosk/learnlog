The deletion pass needs the same scrutiny from the other side, where
the danger arrives as a link in the tree rather than as a name in the
dataset.
We hang two links in the working directory, one at a directory and one
at a file, both pointing outside it, and claim neither in the
snapshot.
Restoring has to remove both links and run to the end, and everything
they pointed at has to survive---which is precisely the difference
between the [[unlink]] this branch performs and the [[rmdir]] it
avoids:

<<progsnap2 test functions>>=
def test_restore_code_state_removes_symlinks_not_targets(tmp_path):
    from learnlog.progsnap2 import restore_code_state

    outside = tmp_path / "outside"
    outside.mkdir()
    (outside / "secret.txt").write_text("keep\n")

    workdir = tmp_path / "work"
    workdir.mkdir()
    (workdir / "dirlink").symlink_to(
        outside, target_is_directory=True,
    )
    (workdir / "filelink").symlink_to(outside / "secret.txt")

    restore_code_state(workdir, {"main.py": "print('main')\n"})

    assert not (workdir / "dirlink").is_symlink()
    assert not (workdir / "filelink").is_symlink()
    assert (workdir / "main.py").read_text() == "print('main')\n"
    assert (outside / "secret.txt").read_text() == "keep\n"
    assert sorted(p.name for p in outside.iterdir()) == \
        ["secret.txt"]
