A link whose name the snapshot \emph{does} claim is what the
unconditional removal is for.
The link has to point inside the working directory for the test to
reach the write pass at all, since a name resolving outside is refused
before then, so we aim it at a second file that the same snapshot also
claims.
Restoring both names must leave two files: if the link survived the
deletion pass, [[main.py]] would still be a link and the content meant
for it would have landed in [[real.py]]:

<<progsnap2 test functions>>=
def test_restore_code_state_replaces_a_claimed_symlink(tmp_path):
    from learnlog.progsnap2 import restore_code_state

    workdir = tmp_path / "work"
    workdir.mkdir()
    (workdir / "real.py").write_text("real\n")
    (workdir / "main.py").symlink_to(workdir / "real.py")

    restore_code_state(workdir, {
        "main.py": "print('main')\n",
        "real.py": "print('real')\n",
    })

    assert not (workdir / "main.py").is_symlink()
    assert (workdir / "main.py").read_text() == "print('main')\n"
    assert (workdir / "real.py").read_text() == "print('real')\n"
