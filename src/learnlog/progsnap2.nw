The claim that review events leave the analysis alone is easy to state
and easy to get wrong, so we check it against the shape of the report
rather than against its text.
The repository below is the awkward arrangement: the student runs,
edits, \emph{reviews}, and only then runs again---so a review sits
exactly where it could steal the pending edit.
Deleting the review events from the same stream must produce the same
pairs, which is a stronger statement than \enquote{it did not crash}:
the report is not merely still generated, it is the report the run
would have produced.
The command itself gets the last word, because the pieces can each be
right while the path a user actually takes is not: the same repository
goes through [[learnlog analyse]] end to end, and the report it prints
has to have the same two runs in it.

<<progsnap2 test functions>>=
def test_analyse_ignores_review_events(workdir, monkeypatch):
    """A review between an edit and a run changes no table."""
    from learnlog.progsnap2 import (
        do_export_progsnap2,
        generate_analysis_latex,
        group_edit_run_pairs,
        read_progsnap2,
    )
    repo = LearnlogRepo(workdir)
    repo.begin_run(
        "hello.py", [], datetime.datetime(2026, 1, 1, 10, 0)
    )
    repo.finalize_run(
        io_log="stdout: v1\n",
        exception_info=None,
        end_time=datetime.datetime(2026, 1, 1, 10, 0, 1),
        exit_code=0,
    )
    (workdir / "hello.py").write_text('print("v2")\n')
    repo.begin_run(
        "learnlog", ["play"],
        datetime.datetime(2026, 1, 1, 10, 2),
    )
    repo.finalize_run(
        io_log="",
        exception_info=None,
        end_time=datetime.datetime(2026, 1, 1, 10, 2, 30),
        exit_code=0,
        view_trace=[(
            datetime.datetime(2026, 1, 1, 10, 2, 5),
            "a" * 40, "open",
        )],
    )
    repo.begin_run(
        "hello.py", [], datetime.datetime(2026, 1, 1, 10, 5)
    )
    repo.finalize_run(
        io_log="stdout: v2\n",
        exception_info=None,
        end_time=datetime.datetime(2026, 1, 1, 10, 5, 1),
        exit_code=0,
    )

    output = workdir / "analyse.progsnap2"
    do_export_progsnap2(repo, output)
    dataset = read_progsnap2(output)

    def shape(grouped):
        return {
            sid: {
                tag: [
                    (
                        pair["edit"] and pair["edit"]["EventID"],
                        pair["run"] and pair["run"]["EventID"],
                    )
                    for pair in pairs
                ]
                for tag, pairs in tags.items()
            }
            for sid, tags in grouped.items()
        }

    grouped = group_edit_run_pairs(dataset["events"])
    without_reviews = [
        event for event in dataset["events"]
        if not event["EventType"].startswith("X-Review")
    ]
    assert shape(grouped) == shape(
        group_edit_run_pairs(without_reviews)
    )

    pairs = next(iter(grouped.values()))[""]
    assert len(pairs) == 2
    assert all(
        pair["edit"] is not None and pair["run"] is not None
        for pair in pairs
    )
    assert [
        pair["run"]["X-Script"] for pair in pairs
    ] == ["hello.py", "hello.py"]

    latex = generate_analysis_latex(dataset, grouped)
    assert latex.count("\\paragraph{Run ") == 2
    assert "learnlog" not in latex

    from learnlog.cli import app
    from typer.testing import CliRunner
    monkeypatch.chdir(workdir)
    result = CliRunner().invoke(app, ["analyse"])
    assert result.exit_code == 0
    assert result.output.count("\\paragraph{Run ") == 2
