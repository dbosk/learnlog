            "stdout: done"
        ),
        exception_info=None,
        end_time=datetime.datetime(
            2026, 1, 1, 10, 0, 5
        ),
        exit_code=0,
    )
    output = workdir / "test.progsnap2"
    do_export_progsnap2(repo, output)
