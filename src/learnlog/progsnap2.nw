def test_progsnap2_round_trips_python_c_arguments(workdir):
    import csv as csv_mod
    import shutil
    from learnlog.gitrepo import parse_run_arguments
    from learnlog.progsnap2 import (
        do_export_progsnap2, read_progsnap2_as_repo,
    )
    source = 'import sys\nprint("hi there")'
    args = [source, "alpha", "beta"]
    repo = LearnlogRepo(workdir)
    t1 = datetime.datetime(2026, 1, 1, 10, 0)
    repo.begin_run("<python -c>", args, t1)
    repo.finalize_run(
        io_log="stdout: hi there\n",
        exception_info=None,
        end_time=datetime.datetime(2026, 1, 1, 10, 0, 1),
        exit_code=0,
    )
    output = workdir / "c.progsnap2"
    do_export_progsnap2(repo, output)

    with zipfile.ZipFile(str(output)) as zf:
        main = zf.read("MainTable.csv").decode("utf-8")
    runs = [
        event for event in csv_mod.DictReader(io.StringIO(main))
        if event["EventType"] == "Run.Program"
