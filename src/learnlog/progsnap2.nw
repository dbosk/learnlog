def test_progsnap2_emits_view_events(workdir):
    """Each Viewed: line becomes an ordered child event."""
    import csv as csv_mod
    from learnlog.progsnap2 import do_export_progsnap2
    repo = LearnlogRepo(workdir)
    first, second = "a" * 40, "b" * 40
    t1 = datetime.datetime(2026, 1, 1, 10, 0)
    repo.begin_run("learnlog", ["play"], t1)
    repo.finalize_run(
        io_log="",
        exception_info=None,
        end_time=datetime.datetime(2026, 1, 1, 10, 0, 20),
        exit_code=0,
        view_trace=[
            (datetime.datetime(2026, 1, 1, 10, 0, 1),
             first, "open"),
            (datetime.datetime(2026, 1, 1, 10, 0, 5),
             second, "next"),
            (datetime.datetime(2026, 1, 1, 10, 0, 9),
             first, "prev"),
        ],
    )
    output = workdir / "views.progsnap2"
    do_export_progsnap2(repo, output)
    with zipfile.ZipFile(str(output)) as zf:
        main = zf.read("MainTable.csv").decode("utf-8")
    reader = csv_mod.DictReader(io.StringIO(main))
    events = list(reader)

    review = [
        e for e in events if e["EventType"] == "X-Review"
    ]
    assert len(review) == 1
    views = [
        e for e in events
        if e["EventType"] == "X-Review.View"
    ]
    assert [
        (v["X-ViewedCommit"], v["X-ViewAction"],
         v["ServerTimestamp"])
        for v in views
    ] == [
        (first, "open", "2026-01-01T10:00:01"),
        (second, "next", "2026-01-01T10:00:05"),
        (first, "prev", "2026-01-01T10:00:09"),
    ]
    assert all(
        v["ParentEventID"] == review[0]["EventID"]
        for v in views
    )
    orders = [int(v["Order"]) for v in views]
    assert orders == sorted(orders)
    assert min(orders) > int(review[0]["Order"])
    assert all(
        v["ClientTimestamp"] == v["ServerTimestamp"]
        for v in views
    )
