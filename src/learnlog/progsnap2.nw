def test_read_progsnap2_roundtrips_binary_file(workdir):
    """Binary code-state files survive export and read-back."""
    from learnlog.progsnap2 import (
        do_export_progsnap2, read_progsnap2,
    )
    blob = b"\x89PNG\r\n\x1a\n\x00\xff\xferaw"
    (workdir / "logo.png").write_bytes(blob)
    repo = LearnlogRepo(workdir)
    t1 = datetime.datetime(2026, 1, 1, 10, 0)
    repo.begin_run("hello.py", [], t1)
    repo.finalize_run(
        io_log="stdout: hi\n",
        exception_info=None,
