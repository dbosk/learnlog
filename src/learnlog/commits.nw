The fallback needs a trailer commit the index cannot place, and
[[finalize_run]] never writes one, so the test writes it with
plumbing: [[commit-tree]] hangs a message on a chosen parent
without touching the index or the current branch, and the parent
link and the message are all this function reads.

<<commits test functions>>=
def test_resolve_record_commit_without_run_id(workdir):
    """A trailer with no run id falls back to its parent."""
    from learnlog.commits import resolve_record_commit
    repo = LearnlogRepo(workdir)
    repo.begin_run(
        "hello.py", [], datetime.datetime(2026, 1, 1, 10, 0),
    )
    header = repo.git("rev-parse", "HEAD").stdout.strip()
    tree = repo.git(
        "rev-parse", "HEAD^{tree}",
    ).stdout.strip()
    legacy = repo.git(
        "commit-tree", tree, "-p", header, "-F", "-",
        input=(
            "Run-End: hello.py (none)\n"
            "\n"
            "End-Time: 2026-01-01T10:00:01\n"
            "Exit-Code: 0\n"
        ),
    ).stdout.strip()

    assert resolve_record_commit(repo, legacy) == header
