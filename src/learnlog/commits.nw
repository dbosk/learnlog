    assert format_elapsed(None) == ""
    assert format_elapsed(-5) == "< 1 s"
    assert format_elapsed(0.2) == "< 1 s"
    assert format_elapsed(5) == "5 s"
    assert format_elapsed(120) == "2 min"
    assert format_elapsed(135) == "2 min 15 s"
    assert format_elapsed(3780) == "1 h 3 min"
