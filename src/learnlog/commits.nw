def test_resolve_record_commit_maps_trailer_to_header(workdir):
    from learnlog.commits import resolve_record_commit
    repo = LearnlogRepo(workdir)
    repo.begin_run(
        "hello.py", [], datetime.datetime(2026, 1, 1, 10, 0),
    )
    header = repo.git("rev-parse", "HEAD").stdout.strip()
    repo.finalize_run(
        io_log="",
        exception_info=None,
        end_time=datetime.datetime(2026, 1, 1, 10, 0, 1),
        exit_code=0,
    )
    trailer = repo.git("rev-parse", "HEAD").stdout.strip()
    assert resolve_record_commit(repo, trailer) == header
    assert resolve_record_commit(repo, header) == header
