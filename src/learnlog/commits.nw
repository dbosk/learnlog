Those tags are all lightweight, so they exercise only the
[[%(objectname)]] half of the format string.
A test for the other half has to be careful about which
commit it tags, because [[resolve_record_commit]] hides
the bug on exactly the commit one would reach for first.
It asks Git for the tagged object's subject and for its
first parent, and both of those requests peel a tag object
on their way to a commit---so a tag object naming a
\emph{trailer} commit still comes back as that run's
header commit, by accident rather than by design.
Everywhere else, including the header commit itself, the
tag object's hash is what [[resolve_record_commit]]
returns unchanged, and the tag is lost.

So we tag a header commit by name, put one tag of each
kind on it, and assert both names against that one hash.
Dropping either half of the format string then fails the
test, and the assertion states the invariant the two kinds
share: how a tag was created must not change which commit
it lands on.

<<commits test functions>>=
def test_get_tag_map_annotated_tag(workdir):
    """Annotated and lightweight tags land alike."""
    from learnlog.commits import get_tag_map
    repo = LearnlogRepo(workdir)
    repo.begin_run(
        "hello.py", [],
        datetime.datetime(2026, 1, 1, 10, 0),
    )
    header = repo.git("rev-parse", "HEAD").stdout.strip()
    repo.git("tag", "lab1", header)
    repo.git(
        "tag", "-a", "-m", "handed in", "submitted", header,
    )
    repo.finalize_run(
        io_log="",
        exception_info=None,
        end_time=datetime.datetime(2026, 1, 1, 10, 0, 1),
        exit_code=0,
    )
    names = get_tag_map(repo)[header]
    assert "lab1" in names
    assert "submitted" in names
@

The odd tags get the same treatment, from the other side:
we put a blob tag and a tree tag next to a good one and
require the good one to survive them.
The assertion has to look through the whole map rather
than at one commit's entry, because the failure being
pinned is not a wrong name under the right hash but an
entry filed under a hash no caller will ever look up.

<<commits test functions>>=
def test_get_tag_map_skips_non_commit_tags(workdir):
    """Tags on a blob or a tree stay out of the map."""
    from learnlog.commits import get_tag_map
    repo = LearnlogRepo(workdir)
    repo.begin_run(
        "hello.py", [],
        datetime.datetime(2026, 1, 1, 10, 0),
    )
    header = repo.git("rev-parse", "HEAD").stdout.strip()
    repo.git("tag", "lab1", header)
    blob = repo.git(
        "hash-object", "-w", "hello.py",
    ).stdout.strip()
    repo.git("tag", "notes", blob)
    tree = repo.git(
        "rev-parse", "HEAD^{tree}",
    ).stdout.strip()
    repo.git("tag", "base", tree)

    tag_map = get_tag_map(repo)

    assert tag_map[header] == ["lab1"]
    tagged = [name for names in tag_map.values() for name in names]
    assert tagged == ["lab1"]
@

The map is looked up by the hash of a commit the caller is
already showing---an event's code state in the ProgSnap2 export
(\cref{progsnap2}), a listed commit in the viewer---so an entry
filed under anything else is a tag that no caller will ever see.
Overlapping runs used to produce exactly that, since
[[learnlog tag]] marks HEAD and HEAD after an inner run finished
first is the outer run's trailer commit.
Asserting on the whole map rather than on one entry is what
distinguishes the tag landing on its run from it merely landing
somewhere.

<<commits test functions>>=
def test_get_tag_map_overlapping_runs(workdir):
    """A tag on the newest trailer lands on its own run."""
    from learnlog.commits import get_tag_map
    outer = LearnlogRepo(workdir)
    inner = LearnlogRepo(workdir)
    t0 = datetime.datetime(2026, 1, 1, 10, 0)

    outer.begin_run("outer.py", [], t0)
    outer_header = outer.git(
        "rev-parse", "HEAD",
    ).stdout.strip()
    inner.begin_run("inner.py", [], t0)
    inner.finalize_run(
        io_log="", exception_info=None,
        end_time=t0 + datetime.timedelta(seconds=1),
        exit_code=0,
    )
    outer.finalize_run(
        io_log="", exception_info=None,
        end_time=t0 + datetime.timedelta(seconds=2),
        exit_code=0,
    )
    outer.git("tag", "lab1")

    tag_map = get_tag_map(outer)

    assert list(tag_map) == [outer_header]
    assert tag_map[outer_header] == ["lab1"]
@

The details reader adds surface the map tests cannot pin: the
guarded [[%(contents)]], the NUL framing, and the ordering
promise.
The lightweight case is the trap from above---the commit's own
message must not leak into the tag---so the test tags a run
header, whose commit message is never empty, and requires an
empty message on the tag:

<<commits test functions>>=
def test_get_tag_details_lightweight_has_no_message(workdir):
    """A lightweight tag reports no message of its own."""
    from learnlog.commits import get_tag_details
    repo = LearnlogRepo(workdir)
    repo.begin_run(
        "hello.py", [],
        datetime.datetime(2026, 1, 1, 10, 0),
    )
    repo.git("tag", "lab1")
    detail, = get_tag_details(repo)
    assert detail.name == "lab1"
    assert detail.annotated is False
    assert detail.message == ""
    assert detail.tagger == ""
    assert detail.date == ""

def test_get_tag_details_annotated_keeps_multiline_message(workdir):
    """Message, tagger and date survive the framing."""
    from learnlog.commits import get_tag_details
    repo = LearnlogRepo(workdir)
    repo.git(
        "tag", "-a", "-F", "-", "submitted",
        input="first line\n\nbody with\ntwo lines\n",
    )
    detail, = get_tag_details(repo)
    assert detail.annotated is True
    assert detail.message.rstrip("\n") == \
        "first line\n\nbody with\ntwo lines"
    assert detail.tagger
    assert detail.date

def test_get_tag_details_orders_by_name(workdir):
    """Creation order does not leak into the answer."""
    from learnlog.commits import get_tag_details
    repo = LearnlogRepo(workdir)
    for name in ["lab2", "lab1", "milestone"]:
        repo.git("tag", name)
    names = [tag.name for tag in get_tag_details(repo)]
    assert names == ["lab1", "lab2", "milestone"]
