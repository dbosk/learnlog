def test_resolve_record_commit_fifo_overlap(workdir):
    """The first trailer names its own run, not the next one."""
    from learnlog.commits import resolve_record_commit
    first = LearnlogRepo(workdir)
    second = LearnlogRepo(workdir)
    t0 = datetime.datetime(2026, 1, 1, 10, 0)

    first.begin_run("a.py", [], t0)
    first_header = first.git("rev-parse", "HEAD").stdout.strip()
    second.begin_run("b.py", [], t0)
    first.finalize_run(
        io_log="", exception_info=None,
        end_time=t0 + datetime.timedelta(seconds=1),
        exit_code=0,
    )
    first_trailer = first.git(
        "rev-parse", "HEAD",
    ).stdout.strip()
    second.finalize_run(
        io_log="", exception_info=None,
        end_time=t0 + datetime.timedelta(seconds=2),
        exit_code=0,
