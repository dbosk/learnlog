The re-gluing walk is a guard against foreign repositories, not
a tested-in-anger path---[[git tag]] will not write a NUL---so
it is verified on a synthetic record rather than a repository:

<<commits test functions>>=
def test_tag_detail_groups_reglues_a_nul_in_the_message():
    """A NUL inside a message does not shift the fields."""
    from learnlog.commits import _tag_detail_groups
    opener = "a" * 40 + " commit"
    output = (
        "\0" + opener + "\0v1\0tag\0Ada\0date\0body\0with nul\n"
        "\0" + opener + "\0v2\0commit\0\0\0\n"
    )
    first, second = _tag_detail_groups(output)
    assert first[5] == "body\0with nul\n"
    assert second[1] == "v2"
