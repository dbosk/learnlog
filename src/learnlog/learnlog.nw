            workdir=workdir, env=test_env, name="exit_raise.py",
        )
        assert result.returncode == 1
        assert "Exit-Code: 1" in message
        assert "ValueError: boom" in message

    def test_worker_thread_exit_is_ignored(self, workdir, test_env):
        result, message = run_and_read_commit(
            "import learnlog\n"
            "import sys\n"
            "import threading\n"
            "worker = threading.Thread(target=lambda: sys.exit(3))\n"
            "worker.start()\n"
            "worker.join()\n"
            "print('main thread continues')\n",
            workdir=workdir, env=test_env, name="exit_thread.py",
        )
        assert result.returncode == 0
        assert "Exit-Code: 0" in message
