def _log_records(workdir):
    """Return ``(hash, subject)`` pairs, oldest first."""
    result = subprocess.run(
        ["git", "--git-dir=.learnlog", "--work-tree=.",
         "log", "--reverse", "--format=%H %s"],
        cwd=str(workdir),
