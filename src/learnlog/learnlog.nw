Some initialisation tests need stricter control than a normal
[[python script.py]] run can provide.
They must set [[sys.argv]] or [[LEARNLOG_PROJECT_ROOT]] before
the first [[import learnlog]], and the installed [[.pth]] hook in the
Poetry venv would otherwise import the package during interpreter
startup.
For those cases we launch [[python -S -c ...]] and add the checkout's
[[src/]] directory to [[PYTHONPATH]] ourselves.
Skipping [[site.py]] avoids all [[.pth]] processing, while the explicit
[[PYTHONPATH]] keeps the package importable from the working tree.

<<test helpers>>=
def run_explicit_import(code, *, cwd, env, argv=None):
    """Run ``code`` with the first ``learnlog`` import under test control."""
    run_env = env.copy()
    source_root = pathlib.Path(__file__).resolve().parents[2] / "src"
    pythonpath = str(source_root)
    existing_pythonpath = run_env.get("PYTHONPATH")
    if existing_pythonpath:
        pythonpath = pythonpath + os.pathsep + existing_pythonpath
    run_env["PYTHONPATH"] = pythonpath

    prelude = []
    if argv is not None:
        prelude.append(f"sys.argv = {argv!r}")
    command = [
        sys.executable,
        "-S",
        "-c",
        "\n".join(["import sys", *prelude, code]),
    ]
    return subprocess.run(
        command,
        cwd=str(cwd),
        env=run_env,
        capture_output=True,
        text=True,
        timeout=30,
    )
@

