The helper assembles the records the way every reader does---one entry
per run, with the trailer merged back into its header---so the test
checks what a teacher would see rather than the commit layout:

<<test helpers>>=
def _run_records(workdir):
    """Map run subjects to their complete run records."""
    from learnlog.commits import (
        get_commits,
        get_run_trailers,
        merge_run_trailers,
    )
    from learnlog.gitrepo import LearnlogRepo

    repo = LearnlogRepo(workdir)
    trailers = get_run_trailers(repo)
    records = {}
    for commit in get_commits(repo):
        if not commit["subject"].startswith("Run: "):
            continue
        body = repo.git(
            "log", "-1", "--format=%B", commit["hash"],
        ).stdout
        records[commit["subject"]] = merge_run_trailers(
            body, trailers,
        )
    return records
@


