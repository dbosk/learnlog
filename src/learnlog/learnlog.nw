def test_nested_runs_keep_their_own_records(workdir, test_env):
    """A logged program starting another yields two records."""
    env = dict(test_env, LEARNLOG_PROJECT_ROOT=str(workdir))
    (workdir / "child.py").write_text(
        "import learnlog\n"
        "print('CHILD')\n"
    )
    (workdir / "parent.py").write_text(
        "import learnlog\n"
        "import subprocess\n"
        "import sys\n"
        "print('PARENT before')\n"
        "subprocess.run([sys.executable, 'child.py'])\n"
        "print('PARENT after')\n"
    )

    result = subprocess.run(
        [sys.executable, "parent.py"],
        cwd=str(workdir), env=env,
        capture_output=True, text=True, timeout=60,
    )
    assert result.returncode == 0

    records = _run_records(workdir)
    parent_record = records["Run: parent.py (none)"]
    child_record = records["Run: child.py (none)"]
    assert "Exit-Code: 0" in parent_record
    assert "stdout: PARENT before" in parent_record
    assert "stdout: PARENT after" in parent_record
    assert "CHILD" not in parent_record
    assert "Exit-Code: 0" in child_record
    assert "stdout: CHILD" in child_record
