@pytest.fixture
def test_env():
    """Environment for explicit-import subprocess tests.

    Callers must launch the interpreter with ``-S``: that is what
    keeps the development venv's autostart ``.pth`` out of the run,
    and it is why ``PYTHONPATH`` has to carry the checkout's
    ``src/`` tree.  Also clears the two ``LEARNLOG_`` variables that
    would otherwise leak in from the parent pytest process.
    """
    env = os.environ.copy()
    env["PYTHONPATH"] = checkout_pythonpath(env)
    env.pop("LEARNLOG_PROJECT_ROOT", None)
    env.pop("LEARNLOG_SKIP_AUTOSTART", None)
    env["GIT_AUTHOR_NAME"] = "Test"
    env["GIT_AUTHOR_EMAIL"] = "test@test"
    env["GIT_COMMITTER_NAME"] = "Test"
    env["GIT_COMMITTER_EMAIL"] = "test@test"
    return env
@

Prepending rather than replacing matters: the parent pytest process may
itself have been started with a [[PYTHONPATH]] that the child still
needs, and the checkout must win over any installed copy of the
package.

<<test helpers>>=
def checkout_pythonpath(env):
    """Return a ``PYTHONPATH`` with this checkout's ``src/`` first."""
    source_root = pathlib.Path(__file__).resolve().parents[2] / "src"
    existing = env.get("PYTHONPATH")
    if existing:
        return str(source_root) + os.pathsep + existing
    return str(source_root)
@

Some initialisation tests need stricter control still.
They must set [[sys.argv]], sometimes [[sys.orig_argv]], or
[[LEARNLOG_PROJECT_ROOT]] before the first [[import learnlog]], which a
[[python script.py]] run cannot do.
For those cases we launch [[python -S -c ...]] with the same
[[PYTHONPATH]] arrangement and a prelude that rewrites [[sys]] before
the import under test.

The helper also mirrors CPython's split view of [[python -c]].
Real interpreters expose the source via [[sys.orig_argv]] but not via
[[sys.argv]], so tests that want to simulate the actual startup path must
be able to override both independently.

<<test helpers>>=
def run_explicit_import(code, *, cwd, env, argv=None, orig_argv=None):
    """Run ``code`` with the first ``learnlog`` import under test control.

    Expects ``env`` from the ``test_env`` fixture, which supplies the
    ``PYTHONPATH`` that ``-S`` makes necessary.
    """
    run_env = env.copy()

    prelude = []
    if argv is not None:
        prelude.append(f"sys.argv = {argv!r}")
    if orig_argv is not None:
        prelude.append(f"sys.orig_argv = {orig_argv!r}")
    command = [
        sys.executable,
        "-S",
        "-c",
        "\n".join(["import sys", *prelude, code]),
    ]
    return subprocess.run(
        command,
        cwd=str(cwd),
        env=run_env,
        capture_output=True,
        text=True,
        timeout=30,
    )
@

