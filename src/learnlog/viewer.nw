The gap line should appear from the second run onward, never on the first.
We edit the file before each run so both runs produce their own [[Run:]]
commit; the first run's only predecessor is the initial commit, which carries
no run and is therefore skipped, so only the second run prints a gap:

<<viewer test functions>>=
def test_play_batch_shows_time_since_last_run(workdir, capsys):
    """Only the second of two run commits gets a gap line."""
    import datetime
    from learnlog.viewer import play_batch
    from learnlog.commits import get_commits
    from learnlog.gitrepo import LearnlogRepo
    repo = LearnlogRepo(workdir)
    (workdir / "hello.py").write_text('print("v1")\n')
    repo.begin_run(
        "hello.py", [],
        datetime.datetime(2026, 1, 1, 10, 0),
    )
    (workdir / "hello.py").write_text('print("v2")\n')
    repo.begin_run(
        "hello.py", [],
        datetime.datetime(2026, 1, 1, 10, 2, 15),
    )
    commits = get_commits(repo)
    play_batch(repo, commits)
    captured = capsys.readouterr().out
    assert "Time since last run:" in captured
    assert captured.count("Time since last run:") == 1
    gap_pos = captured.index("Time since last run:")
    second_pos = captured.index(commits[-1]["hash"])
    assert gap_pos < second_pos
