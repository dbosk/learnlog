The batch trace must agree with the page, so we give the log one
commit that batch mode prints and one it drops---the [[pip]] install
of learnlog is internal in every view (\cref{sec:filter-learnlog})---
and require the trace to list exactly the printed ones:

<<viewer test functions>>=
def test_play_batch_records_each_commit(
    workdir, capsys, monkeypatch,
):
    """The trace names the commits batch mode printed."""
    import datetime
    import learnlog
    from learnlog.viewer import play_batch
    from learnlog.commits import get_commits
    from learnlog.gitrepo import LearnlogRepo
    monkeypatch.setattr(learnlog, "repo", object())
    monkeypatch.setattr(learnlog, "view_trace", [])
    repo = LearnlogRepo(workdir)
    moment = datetime.datetime(2026, 1, 1, 10, 0)
    repo.begin_run("hello.py", [], moment)
    repo.begin_run("pip", ["install", "learnlog"], moment)

    commits = get_commits(repo)
    play_batch(repo, commits)
    printed = capsys.readouterr().out

    assert [
        (commit, action)
        for _, commit, action in learnlog.view_trace
    ] == [
        (commits[0]["hash"], "batch"),
        (commits[1]["hash"], "batch"),
    ]
    assert commits[2]["hash"] not in printed
