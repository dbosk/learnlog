def test_play_batch_renders_review_run(workdir, capsys):
    """A review run is a record like any other."""
    import datetime
    from learnlog.viewer import play_batch
    from learnlog.commits import get_commits
    from learnlog.gitrepo import LearnlogRepo
    repo = LearnlogRepo(workdir)
    repo.begin_run(
        "learnlog", ["play"],
        datetime.datetime(2026, 1, 1, 10, 0),
    )
    repo.finalize_run(
        io_log="",
        exception_info=None,
        end_time=datetime.datetime(2026, 1, 1, 10, 0, 20),
        exit_code=0,
    )
    commits = get_commits(repo)
    play_batch(repo, commits)
    captured = capsys.readouterr().out
    assert "Run: learnlog play" in captured
    assert "Exit-Code: 0" in captured
    assert "(learnlog internal run)" not in captured
