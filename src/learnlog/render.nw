class StubCurses:
  """A curses module whose colour support is broken."""
  error = type("error", (Exception,), {})
  A_BOLD = 1
  A_DIM = 2
  A_REVERSE = 4
  COLOR_RED = 1
  COLOR_GREEN = 2
  COLOR_YELLOW = 3
  COLOR_BLUE = 4
  COLOR_CYAN = 6

  def start_color(self):
    pass

  def use_default_colors(self):
    raise self.error("no default colours here")

  def has_colors(self):
    return False

  def init_pair(self, number, foreground, background):
    raise self.error("no colour pairs here")

  def color_pair(self, number):
    return number << 8

def test_curses_styles_degrade_without_colour():
  attributes = curses_styles(StubCurses())
  assert set(attributes) == set(STYLES)
  assert attributes["title"] == StubCurses.A_BOLD
  assert attributes["meta"] == StubCurses.A_DIM
  assert attributes["chrome"] == StubCurses.A_REVERSE
  assert attributes["removed"] == 0
