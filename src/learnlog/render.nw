With a terminal that does support colour, each colour the table names
gets a pair of its own and the attributes combine:

<<render test functions>>=
class ColourCurses(StubCurses):
  def use_default_colors(self):
    pass

  def has_colors(self):
    return True

  def init_pair(self, number, foreground, background):
    pass

def test_curses_styles_allocate_one_pair_per_colour():
  attributes = curses_styles(ColourCurses())
  assert set(attributes) == set(STYLES)
  assert attributes["removed"] != 0
  assert attributes["context"] == 0
  assert attributes["section"] & StubCurses.A_BOLD
  assert attributes["section"] != attributes["hunk"]
  assert attributes["removed"] == attributes["err"]
