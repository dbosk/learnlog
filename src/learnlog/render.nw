Raw mode keeps every line, in order, with nothing added or indented:

<<render test functions>>=
def test_classify_diff_raw_keeps_every_line():
  lines = [
    "diff --git a/a.py b/a.py",
    "index 1111111..2222222 100644",
    "--- a/a.py",
    "+++ b/a.py",
    "@@ -1 +1 @@",
    "-old",
    "+new",
    "",
  ]
  styled = classify_diff(lines, raw=True)
  assert [line.prefix + line.text for line in styled] == lines
  assert styled[0].kind == "dim"
  assert styled[2].kind == "dim"
