def find_linter(workdir, tool=None):
    """Return `(tool, executable)` for the linter to run, or `None`.

    `tool` names the linter to look for (a `Linter` or its value);
    with none, ruff is looked for first and pylint is the fallback.
    Each is looked for in the project's `.venv/bin`, then beside the
    running interpreter, then on the `PATH`, so the student's own
    installation wins over the copy that came with learnlog.
    """
    names = [Linter(tool).value] if tool else [t.value for t in Linter]
    for name in names:
        for candidate in (
            pathlib.Path(workdir) / ".venv" / "bin" / name,
            INTERPRETER_BIN / name,
        ):
            if candidate.is_file():
                return name, str(candidate)
        found = shutil.which(name)
        if found:
            return name, found
    return None
@

Both tools signal findings through their exit status---ruff exits 1
when it found something, pylint sets a bit per message category and
reserves 32 for its own failure---so the status is the answer, not an
error, and only a status that means the tool did not run counts as
failure.
Ruff is run [[--isolated]]: the snapshot may contain the student's own
[[pyproject.toml]], which would otherwise silently redefine the rule
set.

<<metrics functions>>=
def run_linter(tool, executable, files):
    """Count a linter's findings by rule over `files`.

    Returns `{"tool", "total", "findings"}` with `findings` a
    `Counter` by rule code, or `None` when the tool did not run.
    """
    if not files:
        return {"tool": tool, "total": 0,
                "findings": collections.Counter()}
    if tool == "ruff":
        command = [
            executable, "check", "--isolated", "--no-cache",
            "--select", ",".join(RUFF_RULES),
            "--output-format", "json", *map(str, files),
        ]
        accepted, key = (0, 1), "code"
    else:
        command = [
            executable, "--disable=all",
            "--enable=" + ",".join(PYLINT_CHECKS),
            "--output-format=json", "--score=n", *map(str, files),
        ]
        accepted, key = range(32), "symbol"
    <<run the linter and count its findings>>
<<run the linter and count its findings>>=
try:
    result = subprocess.run(
        command, capture_output=True, text=True, check=False,
        timeout=LINT_TIMEOUT,
    )
    if result.returncode not in accepted:
        return None
    findings = collections.Counter(
        item.get(key, "?") for item in json.loads(result.stdout or "[]")
    )
except (OSError, subprocess.TimeoutExpired, ValueError):
    return None
return {
    "tool": tool, "total": sum(findings.values()),
    "findings": findings,
}
