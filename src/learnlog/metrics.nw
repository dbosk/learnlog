\section{Per-bucket results and trends}
\label{sec:metrics-trends}

Each family of metrics produces the same shape---one row of named
values per bucket---so that [[trends]] can join the rows instead of
recomputing anything.

<<metrics functions>>=
@dataclasses.dataclass(frozen=True)
class BucketResult:
    """The values of one metric family for one bucket."""

    label: str
    start: datetime.datetime
    end: datetime.datetime
    values: dict
<<metrics functions>>=
def compute_time(buckets, idle):
    """Time and effort summaries, one per bucket."""
    return [
        BucketResult(bucket.label, bucket.start, bucket.end,
                     time_summary(bucket.sessions, idle))
        for bucket in buckets
    ]
<<metrics functions>>=
def compute_errors(buckets):
    """Error quotients and densities, one row per bucket."""
    results = []
    for bucket in buckets:
        pairs = sum(len(run_pairs(s)) for s in bucket.sessions)
        results.append(BucketResult(
            bucket.label, bucket.start, bucket.end, {
                "pairs": pairs,
                "eq_syntax": error_quotient(bucket.sessions, "syntax"),
                "eq_any": error_quotient(bucket.sessions, "any"),
                "red_syntax": repeated_error_density(
                    bucket.sessions, "syntax"),
                "red_any": repeated_error_density(bucket.sessions, "any"),
            },
        ))
    return results
