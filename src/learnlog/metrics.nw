\section{Rendering}
\label{sec:metrics-render}

A report is a header of the parameters it was computed with, then one
row per bucket.
The header is not decoration: the idle threshold, the EQ variant and
the window are the choices the literature says change the
numbers~\autocite{kovanovic2015penetrating,ahadi2018syntax}, and a
number without them cannot be compared with another.
Values that do not exist print as a dash; a zero would claim something
was measured.

<<metrics imports>>=
import csv
import io
<<metrics functions>>=
class OutputFormat(str, enum.Enum):
    """The renderings a report can take."""

    TABLE = "table"
    CSV = "csv"
    JSON = "json"
    LATEX = "latex"
<<metrics constants>>=
DURATION_KEYS = frozenset({"active_seconds"})
MISSING = "\u2014"
<<metrics functions>>=
def format_value(key, value):
    """Render one cell for a text table."""
    if value is None:
        return MISSING
    if key in DURATION_KEYS:
        minutes = int(round(value / 60))
        return f"{minutes // 60}h {minutes % 60:02d}m"
    if isinstance(value, datetime.datetime):
        return value.strftime("%a %Y-%m-%d %H:%M")
    if isinstance(value, float):
        return f"{value:.2f}"
    if isinstance(value, dict):
        return " ".join(
            f"{code}:{count}" for code, count in sorted(value.items())
        ) or "0"
    return str(value)
<<metrics functions>>=
def render(results, columns, fmt, header_lines):
    """Render `results` in `fmt`.

    `columns` is a sequence of `(key, heading)` pairs; the label
    column comes first without being listed.  Text and LaTeX put
    `header_lines` above the table; CSV prints them as comment
    lines starting with `#`; JSON carries them as `parameters`.
    """
    fmt = OutputFormat(fmt)
    if fmt is OutputFormat.JSON:
        return render_json(results, columns, header_lines)
    if fmt is OutputFormat.CSV:
        return render_csv(results, columns, header_lines)
    if fmt is OutputFormat.LATEX:
        return render_latex(results, columns, header_lines)
    return render_table(results, columns, header_lines)
<<metrics functions>>=
def render_table(results, columns, header_lines):
    """Aligned plain-text table."""
    headings = ["period", *[heading for _, heading in columns]]
    rows = [
        [result.label, *[
            format_value(key, result.values.get(key)) for key, _ in columns
        ]]
        for result in results
    ]
    widths = [
        max(len(row[index]) for row in [headings, *rows])
        for index in range(len(headings))
    ]
    lines = [*header_lines, ""] if header_lines else []
    for row in [headings, *rows]:
        lines.append("  ".join(
            cell.ljust(width) if index == 0 else cell.rjust(width)
            for index, (cell, width) in enumerate(zip(row, widths))
        ).rstrip())
    return "\n".join(lines) + "\n"
<<metrics functions>>=
def render_csv(results, columns, header_lines):
    """CSV with the parameters as `#` comment lines."""
    buffer = io.StringIO()
    for line in header_lines:
        buffer.write(f"# {line}\n")
    writer = csv.writer(buffer)
    writer.writerow(["period", *[key for key, _ in columns]])
    for result in results:
        writer.writerow([result.label, *[
            _csv_value(result.values.get(key)) for key, _ in columns
        ]])
    return buffer.getvalue()
<<metrics functions>>=
def _csv_value(value):
    if value is None:
        return ""
    if isinstance(value, datetime.datetime):
        return value.isoformat()
    if isinstance(value, dict):
        return json.dumps(value, sort_keys=True)
    return value
<<metrics functions>>=
def render_json(results, columns, header_lines):
    """JSON with `parameters` and `rows`."""
    rows = [{
        "period": result.label,
        "start": result.start.isoformat(),
        "end": result.end.isoformat(),
        **{key: _json_value(result.values.get(key))
           for key, _ in columns},
    } for result in results]
    return json.dumps(
        {"parameters": list(header_lines), "rows": rows}, indent=2,
    ) + "\n"
<<metrics functions>>=
def _json_value(value):
    if isinstance(value, datetime.datetime):
        return value.isoformat()
    return value
@

The \LaTeX{} rendering escapes the characters that scripts and rule
codes can contain; the parameters go in as comments, where a
[[\caption]] can quote them.

<<metrics constants>>=
LATEX_SPECIALS = {
    "\\": r"\textbackslash{}", "&": r"\&", "%": r"\%", "$": r"\$",
    "#": r"\#", "_": r"\_", "{": r"\{", "}": r"\}",
    "~": r"\textasciitilde{}", "^": r"\textasciicircum{}",
}
<<metrics functions>>=
def latex_escape(text):
    """Escape `text` for use in LaTeX body text."""
    return "".join(LATEX_SPECIALS.get(char, char) for char in str(text))
<<metrics functions>>=
def render_latex(results, columns, header_lines):
    """A `tabular` with the parameters as comments."""
    lines = [f"% {line}" for line in header_lines]
    lines.append("\\begin{tabular}{l" + "r" * len(columns) + "}")
    lines.append(" & ".join(
        ["period", *[latex_escape(h) for _, h in columns]]
    ) + r" \\ \hline")
    for result in results:
        cells = [latex_escape(result.label), *[
            latex_escape(format_value(key, result.values.get(key)))
            for key, _ in columns
        ]]
        lines.append(" & ".join(cells) + r" \\")
    lines.append("\\end{tabular}")
    return "\n".join(lines) + "\n"
@

