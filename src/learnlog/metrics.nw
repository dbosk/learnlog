def run_records(repo, *, include_learnlog=False):
    """Return every run in the log as a `RunRecord`, oldest first.

    Runs of learnlog itself are left out unless
    `include_learnlog` is set.  Runs whose start time cannot be
    read are left out always.
    """
    scan = scan_run_commits(repo)
    trees = commit_trees(repo)
    churn = commit_churn(repo)
    records = []
    for commit in get_commits(repo):
        commit_hash = commit["hash"]
        message = merge_run_trailers(
            scan.messages.get(commit_hash, ""), scan.trailers,
        )
        <<append a record for each kept run of the commit>>
    records.sort(key=lambda record: record.start)
    return records
<<append a record for each kept run of the commit>>=
edit = churn.get(commit_hash, (0, 0))
for run in parse_commit_runs(message):
    if not include_learnlog and is_learnlog_run(run):
        continue
    start = local_naive(_parse_iso(run["start_time"]))
    if start is None:
        continue
    records.append(RunRecord(
        commit=commit_hash,
        tree=trees.get(commit_hash, ""),
        script=run["script"],
        arguments=run["arguments"],
        start=start,
        end=local_naive(_parse_iso(run["end_time"])),
        exit_code=_int_or_none(run["exit_code"]),
        exception_info=run["exception_info"],
        lines_added=edit[0],
        lines_removed=edit[1],
    ))
    edit = (0, 0)
