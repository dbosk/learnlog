The code and lint families take a function from bucket to snapshot
directory, so that the same code serves the working directory (one
window) and extracted trees (a series); a bucket without a snapshot
gets a row of nulls, which renders as dashes.

<<metrics functions>>=
def compute_code(buckets, snapshot):
    """Static code metrics of each bucket's snapshot."""
    results = []
    for bucket in buckets:
        root = snapshot(bucket)
        values = analyse_snapshot(root) if root else \
            {key: None for key in CODE_KEYS}
        results.append(BucketResult(
            bucket.label, bucket.start, bucket.end, values,
        ))
    return results
<<metrics constants>>=
CODE_KEYS = (
    "files", "unparsable", "sloc", "lloc", "comments", "functions",
    "max_cc", "complex_functions", "volume", "mi_min", "mi_median",
)
<<metrics functions>>=
def compute_lint(buckets, snapshot, linter):
    """Linter counts of each bucket's snapshot.

    `linter` is `(tool, executable)` or `None`; with none, or
    when the tool fails, every value is `None`.
    """
    results = []
    for bucket in buckets:
        root = snapshot(bucket)
        report = None
        if root and linter:
            report = run_linter(*linter, snapshot_files(root))
        values = {
            "lint_tool": report["tool"] if report else None,
            "lint_total": report["total"] if report else None,
            "lint_findings": dict(report["findings"]) if report else None,
        }
        results.append(BucketResult(
            bucket.label, bucket.start, bucket.end, values,
        ))
    return results
<<metrics functions>>=
def join_buckets(*series):
    """Merge parallel `BucketResult` lists by label."""
    merged = {}
    order = []
    for results in series:
        for result in results:
            if result.label not in merged:
                merged[result.label] = BucketResult(
                    result.label, result.start, result.end, {},
                )
                order.append(result.label)
            merged[result.label].values.update(result.values)
    return [merged[label] for label in order]
@

A direction is a word about a series, and the rule that produces it is
printed so the word can be checked.
Missing values are dropped; with fewer than four remaining the answer
is that it is too early to say.
Otherwise the least-squares slope over the buckets that have a value,
scaled to their span and divided by the magnitude of the median value,
is compared with a ten-percent threshold.
The vocabulary is closed---rising, falling, steady---because the
metric's meaning is not: an error quotient that falls is an error
quotient that fell, and whether that is good news is the student's to
say~\autocite{jivet2018license}.
A single improving number can hide a worsening long
tail~\autocite{Ostlund2023}, so the direction never stands alone: the
first and last values, and the row of numbers above it, are always
beside it.

<<metrics constants>>=
TREND_MIN_BUCKETS = 4
TREND_RELATIVE_THRESHOLD = 0.10
TREND_RULE = (
    f"direction: least-squares slope over at least {TREND_MIN_BUCKETS} "
    f"buckets with a value, scaled to the span and divided by the "
    f"median; rising or falling beyond "
    f"{TREND_RELATIVE_THRESHOLD:.0%}, steady within"
)
<<metrics functions>>=
def direction(values, unit="buckets"):
    """Describe how `values` (with `None`s) move over the series."""
    points = [value for value in values if value is not None]
    if len(points) < TREND_MIN_BUCKETS:
        return f"not enough {unit} yet"
    count = len(points)
    mean_x = (count - 1) / 2
    mean_y = sum(points) / count
    slope = sum(
        (index - mean_x) * (value - mean_y)
        for index, value in enumerate(points)
    ) / sum((index - mean_x) ** 2 for index in range(count))
    scale = max(abs(statistics.median(points)), 1e-9)
    relative = slope * (count - 1) / scale
    if relative > TREND_RELATIVE_THRESHOLD:
        return "rising"
    if relative < -TREND_RELATIVE_THRESHOLD:
        return "falling"
    return "steady"
@

The trend lines name the metric, the direction, the span and the
end points, and nothing else; when the answer is that it is too
early, they say only that, since a span and end points would dress
up an absence of evidence as a finding.

<<metrics constants>>=
TREND_COLUMNS = (
    ("active_days", "active days"),
    ("runs", "runs"),
    ("sessions", "sessions"),
    ("active_seconds", "active time"),
    ("failed_runs", "failed runs"),
    ("eq_syntax", "EQ (syntax)"),
    ("eq_any", "EQ (all errors)"),
    ("red_any", "RED (all errors)"),
    ("max_cc", "max complexity"),
    ("sloc", "source lines"),
    ("lint_total", "lint findings"),
)
<<metrics functions>>=
def trend_lines(results, unit="buckets"):
    """One direction line per metric over `results`."""
    lines = []
    for key, name in TREND_COLUMNS:
        series = [result.values.get(key) for result in results]
        word = direction(series, unit)
        present = [value for value in series if value is not None]
        if word.startswith("not enough") or not present:
            lines.append(f"{name}: {word}")
            continue
        span = f"over your last {len(results)} {unit}"
        ends = (f"({format_value(key, present[0])} to "
                f"{format_value(key, present[-1])})")
        lines.append(f"{name}: {word} {span} {ends}")
    return lines
@

Let's verify the direction rule at its edges and that a join keeps the
first series' order.

<<metrics test functions>>=
def test_direction_rule():
  assert direction([1, 2, 3], "weeks") == "not enough weeks yet"
  assert direction([1, None, 2, 3, 4]) == "rising"
  assert direction([0.8, 0.6, 0.5, 0.2]) == "falling"
  assert direction([5, 5, 5, 5, 5]) == "steady"
  assert direction([10, 10.2, 9.9, 10.1]) == "steady"
  assert direction([0, 0, 0, 0]) == "steady"

def test_compute_and_join_buckets():
  sessions = [[_name(0), _name(2)], [_rec(30)]]
  window = (T0, T0 + datetime.timedelta(days=1))
  buckets = bucket_sessions(sessions, Granularity.DAY, window)
  times = compute_time(buckets, IDLE)
  errors = compute_errors(buckets)
  code = compute_code(buckets, lambda bucket: None)
  lint = compute_lint(buckets, lambda bucket: None, None)
  joined = join_buckets(times, errors, code, lint)
  assert [r.label for r in joined] == ["2026-08-31"]
  values = joined[0].values
  assert values["runs"] == 3 and values["pairs"] == 1
  assert values["eq_any"] == 1.0 and values["eq_syntax"] == 0.0
  assert values["red_any"] == 0.5
  assert values["sloc"] is None and values["lint_total"] is None
  assert trend_lines(joined, "days")[0] == \
    "active days: not enough days yet"
  longer = [BucketResult(f"d{i}", T0, T0, {"runs": i})
            for i in range(1, 6)]
  assert trend_lines(longer, "days")[1] == \
    "runs: rising over your last 5 days (1 to 5)"
