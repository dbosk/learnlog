<<metrics test functions>>=
def test_run_records_reads_student_runs_only(workdir):
  (workdir / "main.py").write_text("print(1)\n")
  repo = LearnlogRepo(workdir)
  _record_run(repo, "main.py", T0)
  (workdir / "main.py").write_text("print(1)\nprint(2)\n")
  _record_run(repo, "main.py", T0 + datetime.timedelta(minutes=5),
              exc=NAME_TRACE, code=1)
  _record_run(repo, "learnlog list", T0 + datetime.timedelta(minutes=6))
  records = run_records(repo)
  assert [r.script for r in records] == ["main.py", "main.py"]
  assert records[0].start == T0
  assert records[0].end == T0 + datetime.timedelta(seconds=1)
  assert records[0].exit_code == 0
  assert records[1].exception_info.endswith("not defined")
  assert records[1].tree != records[0].tree
  assert (records[1].lines_added, records[1].lines_removed) == (1, 0)
  assert len(run_records(repo, include_learnlog=True)) == 3
